//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  Stillhalter Community® – MEAN REVERSION v1.2
//  Als ERGÄNZUNG zu Trend Model · MACD Pro · Dual Stochastik · Confluence.
//
//  NEU in v1.2 (Feedback):
//   • Jetzt INDIKATOR statt Strategie — die irreführenden Order-Pfeile mit
//     Beschriftung und Stückzahl (automatische Strategie-Marker) sind weg.
//     Backtest läuft stattdessen als kompakte Tabelle oben rechts
//     (Signal bei Kerzenschluss, Ausführung zur nächsten Eröffnung —
//     gleiche Methodik wie beim Stillhalter Confluence).
//   • Dezente Optik: Bänder deutlich blasser (abschaltbar), damit es
//     zusammen mit den anderen Indikatoren übersichtlich bleibt.
//   • ⚡ Re-Entry jetzt als kleine RAUTE (◆ grün unten / rot oben, ohne
//     Text) — klar unterscheidbar von den Confluence-Dreiecken.
//   • 🎯 Pivot-Punkte größer (small statt tiny).
//  v1.1:
//   • ⚡ Re-Entry-Signale: Z-Score kreuzt aus der Überdehnung ZURÜCK über
//     die Schwelle — live mit Kerzenschluss (Pivot-Punkte werden erst N
//     Kerzen später bestätigt) → als Live-Bestätigung nutzbar.
//   • Trend-Filter (EMA 50/200) gegen das 'fallende Messer'.
//   • Parameter identisch zur MR-Komponente im Confluence (Länge 30,
//     EMA-3-Glättung, ±1σ) — was hier ⚡ zeigt, zählt dort als Punkt.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Stillhalter Mean Reversion v1.2", shorttitle = "Stillhalter Mean Reversion",
     overlay = true, max_bars_back = 500)

// ─── Inputs: Mean Revert Settings ────────────────────────────────────────────
grp_mr = "MEAN REVERT SETTINGS"
trading_style  = input.string("neutral", "Trading Style", options = ["neutral", "bullish", "bearish"], group = grp_mr,
     tooltip = "Verschiebt die Bänder leicht: bullish = Kauf-Seite kommt früher dran "
          + "(Bänder etwas tiefer), bearish umgekehrt. Neutral = Standard.")
noise_suppress = input.int(30, "BB Länge (SMA)", minval = 5, maxval = 100, group = grp_mr,
     tooltip = "Anzahl Kerzen für Durchschnitt und Standardabweichung. 30 = Standard "
          + "und identisch zur Mean-Reversion-Komponente im Stillhalter Confluence.")
signal_thresh  = input.float(1.0, "Signal-Schwelle (×SD)", minval = 0.5, maxval = 4.0, step = 0.1, group = grp_mr,
     tooltip = "Ab wie vielen Standardabweichungen der Kurs als überdehnt gilt. "
          + "1.0 = identisch zum Confluence (±1σ). Höher = seltenere, extremere Signale.")

// ─── Inputs: Signale ─────────────────────────────────────────────────────────
grp_sig = "SIGNALE"
useReentry = input.bool(true, "⚡ Re-Entry-Signale (früh, ohne Verzögerung)", group = grp_sig,
     tooltip = "◆-Raute, sobald der Z-Score aus der Überdehnung ZURÜCK über die "
          + "Schwelle kreuzt — die Rückkehr zum Mittelwert hat begonnen. Kommt "
          + "sofort mit Kerzenschluss und dient als Live-Bestätigung für die "
          + "anderen Stillhalter-Indikatoren.")
usePivot   = input.bool(true, "🎯 Pivot-Signale (exaktes Extrem, bestätigt)", group = grp_sig,
     tooltip = "Punkt am exakten Hoch/Tief der Überdehnung — wird aber erst "
          + "N Kerzen später bestätigt (der Punkt erscheint rückwirkend am Extrem). "
          + "Gut zum Lernen/Analysieren, für Live-Entscheidungen ⚡ nutzen.")
pivot_lb   = input.int(5, "Pivot Lookback", minval = 2, maxval = 20, group = grp_sig,
     tooltip = "Ein Extrem gilt erst als Pivot, wenn links UND rechts so viele Kerzen "
          + "weniger extrem sind. Größer = markantere Extreme, spätere Bestätigung.")
trendFilt  = input.string("Aus", "Trend-Filter", options = ["Aus", "EMA 50", "EMA 200"], group = grp_sig,
     tooltip = "UP-Signale nur OBERHALB, DOWN-Signale nur UNTERHALB der gewählten "
          + "EMA. Verhindert Kauf-Signale im intakten Abwärtstrend ('fallendes "
          + "Messer') — empfohlen: EMA 200 für Cash Secured Puts.")

// ─── Inputs: Anzeige ─────────────────────────────────────────────────────────
grp_st = "ANZEIGE"
showBands   = input.bool(true, "σ-Bänder anzeigen (dezent)", group = grp_st,
     tooltip = "Die ±1σ bis ±4σ-Bänder um den Durchschnitt — bewusst blass "
          + "gehalten, damit es zusammen mit Confluence & Co. übersichtlich "
          + "bleibt. Aus = nur Signale und Tabelle.")
show_bg     = input.bool(false, "Hintergrundfarbe bei Überdehnung", group = grp_st,
     tooltip = "Färbt den Chart-Hintergrund leicht grün (überdehnt unten) bzw. rot "
          + "(überdehnt oben), solange der Zustand anhält.")
showTable   = input.bool(true, "Status-Tabelle anzeigen", group = grp_st,
     tooltip = "Kleine Übersicht: aktueller Z-Score und Zustand (überdehnt/neutral).")
ma_clr      = input.color(color.white, "Mittellinie", group = grp_st)
band_clr_ob = input.color(#FF1744, "OB Bänder (oben)",  group = grp_st,
     tooltip = "Farbe der oberen Bänder — gleiche Signalfarbe wie im Confluence.")
band_clr_os = input.color(#00C853, "OS Bänder (unten)", group = grp_st,
     tooltip = "Farbe der unteren Bänder — gleiche Signalfarbe wie im Confluence.")

// ─── Inputs: Backtest ────────────────────────────────────────────────────────
grp_bt = "BACKTEST"
enableBT   = input.bool(true, "Backtest aktivieren (Tabelle oben rechts)", group = grp_bt,
     tooltip = "Simuliert: Einstieg am ⚡/🎯-UP-Signal, Ausstieg am DOWN-Signal — "
          + "jeweils zur Eröffnung der NÄCHSTEN Kerze (kein Blick in die Zukunft). "
          + "Keine Order-Pfeile im Chart, nur die Kennzahlen-Tabelle.")
btSource   = input.string("Re-Entry", "Backtest-Signalquelle", options = ["Re-Entry", "Pivot"], group = grp_bt,
     tooltip = "Welche Signale der Backtest handelt. Hinweis: Pivot-Signale werden "
          + "erst N Kerzen nach dem Extrem bestätigt — gehandelt wird ehrlich "
          + "zum Bestätigungszeitpunkt, nicht am Extrem.")
initialCapital = input.float(10000, "Startkapital", minval = 1, group = grp_bt)

// ─── Berechnung ──────────────────────────────────────────────────────────────
float ma = ta.sma(close, noise_suppress)
float sd = ta.stdev(close, noise_suppress)

float bias_sd = switch trading_style
    "bullish" => -0.12 * sd
    "bearish" =>  0.12 * sd
    =>            0.0

float u1 = ma + bias_sd + 1.0 * sd
float u2 = ma + bias_sd + 2.0 * sd
float u3 = ma + bias_sd + 3.0 * sd
float u4 = ma + bias_sd + 4.0 * sd
float l1 = ma + bias_sd - 1.0 * sd
float l2 = ma + bias_sd - 2.0 * sd
float l3 = ma + bias_sd - 3.0 * sd
float l4 = ma + bias_sd - 4.0 * sd

float z_raw = sd != 0 ? (close - ma) / sd : 0.0
float bias  = switch trading_style
    "bullish" => -0.12
    "bearish" =>  0.12
    =>            0.0
float z   = z_raw - bias
float z_s = ta.ema(z, 3)   // identische Glättung wie im Stillhalter Confluence

// ─── Trend-Filter ────────────────────────────────────────────────────────────
float emaF = trendFilt == "EMA 50" ? ta.ema(close, 50) : trendFilt == "EMA 200" ? ta.ema(close, 200) : na
bool upOK   = trendFilt == "Aus" or close > emaF
bool downOK = trendFilt == "Aus" or close < emaF
plot(trendFilt != "Aus" ? emaF : na, "Trend-Filter EMA", color = color.new(#EF6C00, 55), linewidth = 1)

// ─── Signale ─────────────────────────────────────────────────────────────────
// ⚡ Re-Entry (früh): Z-Score kreuzt aus der Überdehnung ZURÜCK über die Schwelle
bool reBuy  = useReentry and ta.crossover(z_s, -signal_thresh)  and upOK
bool reSell = useReentry and ta.crossunder(z_s, signal_thresh)  and downOK

// 🎯 Pivot (bestätigt): exaktes Extrem, erscheint pivot_lb Kerzen später
float ph = ta.pivothigh(z_s, pivot_lb, pivot_lb)
float pl = ta.pivotlow(z_s,  pivot_lb, pivot_lb)
bool pivSell = usePivot and not na(ph) and ph >  signal_thresh and downOK
bool pivBuy  = usePivot and not na(pl) and pl < -signal_thresh and upOK

// ─── Hintergrund ─────────────────────────────────────────────────────────────
color bg_col = switch
    show_bg and z_s >  signal_thresh => color.new(band_clr_ob, 92)
    show_bg and z_s < -signal_thresh => color.new(band_clr_os, 92)
    =>                                  color.new(color.black, 100)
bgcolor(bg_col)

// ─── σ-Bänder (bewusst dezent) ───────────────────────────────────────────────
plot(showBands ? ma : na, "Mittellinie", color = color.new(ma_clr, 65), linewidth = 1)

p_u1 = plot(showBands ? u1 : na, "BB +1σ", color = color.new(band_clr_ob, 85), linewidth = 1)
p_u2 = plot(showBands ? u2 : na, "BB +2σ", color = color.new(band_clr_ob, 78), linewidth = 1)
p_u3 = plot(showBands ? u3 : na, "BB +3σ", color = color.new(band_clr_ob, 70), linewidth = 1)
p_u4 = plot(showBands ? u4 : na, "BB +4σ", color = color.new(band_clr_ob, 60), linewidth = 1)
p_l1 = plot(showBands ? l1 : na, "BB -1σ", color = color.new(band_clr_os, 85), linewidth = 1)
p_l2 = plot(showBands ? l2 : na, "BB -2σ", color = color.new(band_clr_os, 78), linewidth = 1)
p_l3 = plot(showBands ? l3 : na, "BB -3σ", color = color.new(band_clr_os, 70), linewidth = 1)
p_l4 = plot(showBands ? l4 : na, "BB -4σ", color = color.new(band_clr_os, 60), linewidth = 1)

fill(p_u1, p_u2, color = color.new(band_clr_ob, 98))
fill(p_u2, p_u3, color = color.new(band_clr_ob, 97))
fill(p_u3, p_u4, color = color.new(band_clr_ob, 95))
fill(p_l1, p_l2, color = color.new(band_clr_os, 98))
fill(p_l2, p_l3, color = color.new(band_clr_os, 97))
fill(p_l3, p_l4, color = color.new(band_clr_os, 95))

// ─── Signal-Marker ───────────────────────────────────────────────────────────
// ⚡ Re-Entry: kleine RAUTE ohne Text (klar unterscheidbar von den
// Confluence-Dreiecken) — grün unten = Rückkehr nach Überdehnung unten
plotshape(reBuy,  "⚡ Re-Entry unten", shape.diamond, location.belowbar,
     color.new(band_clr_os, 0), size = size.tiny)
plotshape(reSell, "⚡ Re-Entry oben",  shape.diamond, location.abovebar,
     color.new(band_clr_ob, 0), size = size.tiny)
// 🎯 Pivot: Punkt rückwirkend am exakten Extrem (nur Visualisierung)
plotshape(pivSell, "🎯 Extrem oben",  shape.circle, location.abovebar,
     color.new(band_clr_ob, 40), size = size.small, offset = -pivot_lb)
plotshape(pivBuy,  "🎯 Extrem unten", shape.circle, location.belowbar,
     color.new(band_clr_os, 40), size = size.small, offset = -pivot_lb)

// ─── Backtest (Tabelle statt Order-Pfeile — wie Stillhalter Confluence) ──────
bool stratBuy  = btSource == "Re-Entry" ? reBuy  : pivBuy
bool stratSell = btSource == "Re-Entry" ? reSell : pivSell

var float equity     = na
var float entryPrice = na
var bool  inPos      = false
var int   trades     = 0
var int   wins       = 0
var bool  pendingBuy  = false
var bool  pendingSell = false

if enableBT
    if na(equity)
        equity := initialCapital
    if stratBuy and not inPos and not pendingBuy
        pendingBuy := true
    if stratSell and inPos and not pendingSell
        pendingSell := true
    if pendingBuy[1] and not inPos
        inPos      := true
        entryPrice := open
        pendingBuy := false
    if pendingSell[1] and inPos
        pnlPct  = (open - entryPrice) / entryPrice
        equity  := equity * (1 + pnlPct)
        trades  += 1
        if pnlPct > 0
            wins += 1
        inPos       := false
        pendingSell := false

winrate = trades > 0 ? wins * 100.0 / trades : 0.0
roiPct  = enableBT and not na(equity) ? (equity / initialCapital - 1) * 100 : 0.0

var table bt = table.new(position.top_right, 2, 4, border_width = 1)
if barstate.islast and enableBT
    table.cell(bt, 0, 0, "Trades",  text_color = color.white)
    table.cell(bt, 1, 0, str.tostring(trades) + (inPos ? " (+1 offen)" : ""), text_color = color.white)
    table.cell(bt, 0, 1, "Winrate", text_color = color.white)
    table.cell(bt, 1, 1, str.tostring(winrate, "#.#") + " %", text_color = color.white)
    table.cell(bt, 0, 2, "ROI",     text_color = color.white)
    table.cell(bt, 1, 2, str.tostring(roiPct, "#.#") + " %", text_color = color.white)
    table.cell(bt, 0, 3, "Equity",  text_color = color.white)
    table.cell(bt, 1, 3, str.tostring(equity, format.mintick), text_color = color.white)

// ─── Status-Tabelle ──────────────────────────────────────────────────────────
var table t = table.new(position.bottom_right, 2, 2, border_width = 1)
if barstate.islast and showTable
    string zust = z_s < -signal_thresh ? "🟢 überdehnt UNTEN — Rückkehr abwarten (⚡)" :
         z_s > signal_thresh ? "🔴 überdehnt OBEN — Rückkehr abwarten (⚡)" : "· neutral"
    table.cell(t, 0, 0, "Z-Score", text_color = color.white, bgcolor = color.new(color.black, 20))
    table.cell(t, 1, 0, str.tostring(z_s, "#.##") + " σ", text_color = color.white, bgcolor = color.new(color.black, 20))
    table.cell(t, 0, 1, "Zustand", text_color = color.white)
    table.cell(t, 1, 1, zust, text_color = color.white)

// ─── Alerts ──────────────────────────────────────────────────────────────────
alertcondition(reBuy,   "⚡ Mean Reversion UP (Re-Entry)",   "Stillhalter Mean Reversion: UP — Rückkehr zum Mittelwert hat begonnen")
alertcondition(reSell,  "⚡ Mean Reversion DOWN (Re-Entry)", "Stillhalter Mean Reversion: DOWN — Rückkehr zum Mittelwert hat begonnen")
alertcondition(pivBuy,  "🎯 Extrem unten bestätigt",         "Stillhalter Mean Reversion: Tief-Extrem bestätigt")
alertcondition(pivSell, "🎯 Extrem oben bestätigt",          "Stillhalter Mean Reversion: Hoch-Extrem bestätigt")
