          + "Stillhalter-Kombination; Kennzahlen je Zeile zusammengefasst.")
strikeRef  = input.string("Area Low/High (N-Kerzen-Extrem)", "Strike-Referenz",
     options = ["Area Low/High (N-Kerzen-Extrem)", "Schlusskurs (eng)"], group = grpB,
     tooltip = "Worauf sich der Strike-Puffer bezieht. Area Low/High = das Tief "
          + "bzw. Hoch der letzten N Kerzen (defensiv — Strike jenseits des "
          + "jüngsten Extrems). Schlusskurs = die enge Variante (mehr Prämie, "
          + "weniger Abstand) — hier zeigt sich am deutlichsten, ob mehr "
          + "Konfluenz wirklich mehr Sicherheit bringt.")
refLen     = input.int(10, "N für Area Low/High (Kerzen)", minval = 1, maxval = 60, group = grpB,
     tooltip = "Über wie viele Kerzen zurück das Area Low (Tief) bzw. Area High "
          + "(Hoch) gesucht wird. 10 = die letzten zwei Handelswochen auf "
          + "Tageskerzen.")
strikeBufPct = input.float(2.0, "Strike-Puffer (%)", minval = 0.0,
     maxval = 10.0, step = 0.5, group = grpB,
     tooltip = "Der simulierte Strike liegt so viele Prozent UNTER dem Area Low "
          + "(Put) bzw. ÜBER dem Area High (Call). Mehr Puffer = höhere "
          + "Trefferquote bei weniger Prämie; der Standardwert ist datenbasiert "
          + "kalibriert.")
premModel  = input.string("Volatilitätsbasiert (empfohlen)", "Prämien-Modell",
     options = ["Volatilitätsbasiert (empfohlen)", "Konstant (% vom Strike)"], group = grpB,
     tooltip = "TradingView kennt keine historischen Optionspreise — die Prämie je "
          + "Trade wird deshalb geschätzt. VOLATILITÄTSBASIERT (Standard): aus der "
          + "tatsächlichen Schwankung der Aktie (historische Volatilität der "
          + "letzten 30 Kerzen × IV-Aufschlag), dem Abstand des Strikes und der "
          + "Restlaufzeit (Optionspreis-Näherung). Weiter entfernte Strikes "
          + "bringen realistisch WENIGER Prämie, volatile Aktien MEHR — nur damit "
          + "ist das Puffer-Tuning ehrlich: Der ROI explodiert nicht mehr, wenn "
          + "man den Puffer aufdreht. KONSTANT: einfache feste Annahme — nur zum "
          + "Vergleich der Zeilen untereinander geeignet, NICHT zum Puffer-Tuning.")
premIvMult = input.float(1.2, "IV-Aufschlag (× historische Volatilität)", minval = 0.8,
     maxval = 2.0, step = 0.1, group = grpB,
     tooltip = "Nur für das volatilitätsbasierte Modell: Optionsmärkte preisen "
          + "meist etwas mehr Schwankung ein, als historisch gemessen wird. "
          + "1.2 = 20% Aufschlag auf die historische Volatilität (typische "
          + "Größenordnung). Höher = optimistischere Prämien.")
premPct    = input.float(1.0, "Prämie (nur Modell 'Konstant', % vom Strike)", minval = 0.1,
     maxval = 5.0, step = 0.1, group = grpB,
     tooltip = "Nur für das konstante Prämien-Modell: Jeder Trade bringt pauschal "
          + "so viel Prämie (in % des Strikes). Bei einer Strike-Verletzung am "
          + "Verfall wird die Verletzungstiefe abgezogen; Win = Trade endet "
          + "netto im Plus.")
minCalDays = input.int(10, "Verfall: erster Freitag nach mind. (Kalendertagen)", minval = 5,
     maxval = 45, group = grpB,
     tooltip = "Der Verfall ist der erste FREITAG, der mindestens so viele "
          + "Kalendertage nach dem Einstieg liegt. Standard 10 = in der Regel der "
          + "Freitag der übernächsten Woche. Kürzere Laufzeiten sind für diesen "
          + "Ansatz tendenziell vorteilhaft.")
btEntry    = input.string("Bar Close — Signal bestätigt, Einstieg nächste Eröffnung", "Ausführung",
     options = ["Bar Close — Signal bestätigt, Einstieg nächste Eröffnung", "Bar Open — sofort am entstehenden Signal (intrabar)"], group = grpB,
     tooltip = "Bar Close (Standard, realistisch): Du wartest, bis die Kerze "
          + "GESCHLOSSEN hat und das Signal damit feststeht — eingestiegen wird "
          + "zum Eröffnungskurs der NÄCHSTEN Kerze. "
          + "Bar Open: Du handelst sofort in dem Moment, in dem das Signal in "
          + "der noch LAUFENDEN Kerze entsteht. Da TradingView im Backtest keine "
          + "Intrabar-Kurse kennt und das Signal über die Schlusswerte definiert "
          + "ist, wird dieser Einstieg mit dem Schlusskurs der Signalkerze "
          + "angenähert. Kein Blick in die Zukunft in beiden Varianten.")
btFrom     = input.time(timestamp("2020-01-01T00:00:00"), "Backtest Start", group = grpB)
btTo       = input.time(timestamp("2099-01-01T00:00:00"), "Backtest Ende",  group = grpB)
initialCapital = input.float(10000, "Startkapital (je Zeile)", minval = 1, group = grpB)

// ── Interne Kalibrierung (datenbasiert optimiert; bewusst KEINE Eingaben) ──
osLevel     = 25
obLevel     = 75
stochLen    = 14
stochSmooth = 3
mrLen       = 40

// ══════════ PRAEMIEN-MODELL + WALK-FORWARD-WERKZEUG (fuer alle BTs) ══════════
f_fridayAfter(int t0) =>
    int tt = t0
    while dayofweek(tt) != dayofweek.friday
        tt += 86400000
    tt

// Volatilitaetsbasierte Praemien-Schaetzung: historische Vol (30 Kerzen,
// annualisiert) x IV-Aufschlag, Optionspreis-Naeherung (Black-Scholes,
// r=0, kumulative Normalverteilung logistisch angenaehert). Ergebnis in
// % vom Strike, Mindest-Praemie 0.02% (Bid-Untergrenze).
bool premConst = premModel == "Konstant (% vom Strike)"
float logRet = math.log(close / nz(close[1], close))
float hvAnn  = ta.stdev(logRet, 30) * math.sqrt(31536000.0 / timeframe.in_seconds())
float hvEff  = math.max(nz(hvAnn, 0.30), 0.08) * premIvMult

f_cnd(float x) =>
    1.0 / (1.0 + math.exp(-1.702 * x))

f_optPremPct(float S, float K, float vol, float days, bool isPut) =>
    float T  = math.max(days, 1.0) / 365.0
    float v  = math.max(vol, 0.05) * math.sqrt(T)
    float d1 = (math.log(S / K) + v * v / 2) / v
    float d2 = d1 - v
    float pr = isPut ? K * f_cnd(-d2) - S * f_cnd(-d1) : S * f_cnd(d1) - K * f_cnd(d2)
    math.max(pr / K * 100, 0.02)

// Referenz-Strike fuer alle Auto-Mini-Backtests (Area Low − Puffer)
float autoKRef = ta.lowest(low, refLen) * (1 - strikeBufPct / 100)

// Walk-Forward-Mini-Short-Put-Backtest je Signalreihe: liefert [Anzahl
// Trades, normiertes Konto]. Jede Aufrufstelle hat ihren eigenen
// Zustand (Pine-Funktionsinstanzen) — gleiche Regeln wie die grosse
// Tabelle, Praemie nach gewaehltem Modell.
f_wfStats(bool entryEvt) =>
    var bool  wOn = false
    var float wK  = na
    var int   wX  = 0
    var float wPr = 0.0
    var int   wN  = 0
    var float wEq = 1.0
    if wOn and time >= wX
        wEq := wEq * (1 + wPr / 100 + math.min(0.0, close / wK - 1))
        wN  += 1
        wOn := false
    if entryEvt and not wOn
        wOn := true
        wK  := autoKRef
        int wXn = f_fridayAfter(time + minCalDays * 86400000)
        wX  := wXn
        wPr := premConst ? premPct : f_optPremPct(close, wK, hvEff, (wXn - time) / 86400000.0, true)
    [wN, wEq]

// Guete einer Signalreihe = Oe je Trade (geometrisch); erst ab 8 Trades
f_wfScore(int n, float eq) =>
    n >= 8 ? math.pow(eq, 1.0 / n) - 1 : -1.0e9

// ══════════════════════════ 1) TREND MODEL ══════════════════════════
// FLIESSENDE LEITER: 8 Trendlinien-Paare zwischen Very Tight und Very
// Loose laufen parallel — der Auto-Modus waehlt je Kerze die Stufe mit
// dem besten Oe je Trade (Walk-Forward, nur Vergangenheit).
tF0 = ta.ema(close, 2)
tS0 = ta.ema(close, 9)    // Very Tight
tF1 = ta.ema(close, 3)
tS1 = ta.ema(close, 12)
tF2 = ta.ema(close, 4)
tS2 = ta.ema(close, 16)   // Tight
tF3 = ta.ema(close, 5)
tS3 = ta.ema(close, 21)
tF4 = ta.ema(close, 6)
tS4 = ta.ema(close, 28)   // Loose
tF5 = ta.ema(close, 8)
tS5 = ta.ema(close, 31)
tF6 = ta.ema(close, 10)
tS6 = ta.ema(close, 33)
tF7 = ta.ema(close, 13)
tS7 = ta.ema(close, 35)   // Very Loose
bool tB0 = tF0 > tS0
bool tB1 = tF1 > tS1
bool tB2 = tF2 > tS2
bool tB3 = tF3 > tS3
bool tB4 = tF4 > tS4
bool tB5 = tF5 > tS5
bool tB6 = tF6 > tS6
bool tB7 = tF7 > tS7
[tN0, tQ0] = f_wfStats(tB0 and not tB0[1])
[tN1, tQ1] = f_wfStats(tB1 and not tB1[1])
[tN2, tQ2] = f_wfStats(tB2 and not tB2[1])
[tN3, tQ3] = f_wfStats(tB3 and not tB3[1])
[tN4, tQ4] = f_wfStats(tB4 and not tB4[1])
[tN5, tQ5] = f_wfStats(tB5 and not tB5[1])
[tN6, tQ6] = f_wfStats(tB6 and not tB6[1])
[tN7, tQ7] = f_wfStats(tB7 and not tB7[1])
var int tmSel = 0
int   tmBestIdx = tmSel
float tmBest = -1.0e9
float[] tmScores = array.from(f_wfScore(tN0, tQ0), f_wfScore(tN1, tQ1), f_wfScore(tN2, tQ2), f_wfScore(tN3, tQ3),
     f_wfScore(tN4, tQ4), f_wfScore(tN5, tQ5), f_wfScore(tN6, tQ6), f_wfScore(tN7, tQ7))
for m = 0 to 7
    float gM = array.get(tmScores, m)
    if gM > -1.0e8 and gM > tmBest
        tmBest := gM
        tmBestIdx := m
tmSel := tmBestIdx

bool autoTrend = trendMode == "Auto (aktienspezifisch)"
int  manSel = trendMode == "Very Tight" ? 0 : trendMode == "Tight" ? 2 : trendMode == "Loose" ? 4 : 7
int  tmUse  = autoTrend ? tmSel : manSel
string tmName = tmUse == 0 ? "EMA 2/9 (Very Tight)" : tmUse == 1 ? "EMA 3/12" : tmUse == 2 ? "EMA 4/16 (Tight)" :
     tmUse == 3 ? "EMA 5/21" : tmUse == 4 ? "EMA 6/28 (Loose)" : tmUse == 5 ? "EMA 8/31" :
     tmUse == 6 ? "EMA 10/33" : "EMA 13/35 (Very Loose)"

trendFast = tmUse == 0 ? tF0 : tmUse == 1 ? tF1 : tmUse == 2 ? tF2 : tmUse == 3 ? tF3 :
     tmUse == 4 ? tF4 : tmUse == 5 ? tF5 : tmUse == 6 ? tF6 : tF7
trendSlow = tmUse == 0 ? tS0 : tmUse == 1 ? tS1 : tmUse == 2 ? tS2 : tmUse == 3 ? tS3 :
     tmUse == 4 ? tS4 : tmUse == 5 ? tS5 : tmUse == 6 ? tS6 : tS7
bullTrend = trendFast > trendSlow
bearTrend = trendFast < trendSlow

trendBuyEvt  = bullTrend and not bullTrend[1]
trendSellEvt = bearTrend and not bearTrend[1]

// ══════════════════════════ 2) MACD PRO (10/35/5) ══════════════════════════
macdLine = ta.ema(close, 10) - ta.ema(close, 35)
sigLine  = ta.ema(macdLine, 5)
hist     = macdLine - sigLine

// Beide Varianten parallel; Auto waehlt walk-forward die bessere.
// Frueh-Modus: Histogramm dreht unter Null nach oben (Momentum-Wende) —
// kommt der Kreuzung im Median 3 Kerzen zuvor
bool mdBuyCross  = ta.crossover(hist, 0)
bool mdSellCross = ta.crossunder(hist, 0)
bool mdBuyFrueh  = hist > hist[1] and hist[1] <= hist[2] and hist < 0
bool mdSellFrueh = hist < hist[1] and hist[1] >= hist[2] and hist > 0
[mdN0, mdQ0] = f_wfStats(mdBuyCross)
[mdN1, mdQ1] = f_wfStats(mdBuyFrueh)
var int mdSel = 0
mdSel := f_wfScore(mdN1, mdQ1) > math.max(f_wfScore(mdN0, mdQ0), -1.0e8) ? 1 : f_wfScore(mdN0, mdQ0) > -1.0e8 ? 0 : mdSel
bool autoMacd = macdMode == "Auto (aktienspezifisch)"
macdFrueh = autoMacd ? mdSel == 1 : macdMode == "Früh (Histogramm dreht)"
string mdName = macdFrueh ? "Früh (Histogramm dreht)" : "Kreuzung (klassisch)"
macdBuyEvt  = macdFrueh ? mdBuyFrueh : mdBuyCross
macdSellEvt = macdFrueh ? mdSellFrueh : mdSellCross

// ══════════════════════════ 3) DUAL STOCHASTIC ══════════════════════════
k1 = ta.sma(ta.stoch(close, high, low, stochLen), stochSmooth)
k2 = ta.sma(ta.stoch(close, high, low, 35), 10)

// Beide Varianten parallel; Auto waehlt walk-forward die bessere.
bool stBuyDual  = ta.crossover(k1, osLevel)  and k2 < osLevel
bool stSellDual = ta.crossunder(k1, obLevel) and k2 > obLevel
bool stBuySing  = ta.crossover(k1, osLevel)
bool stSellSing = ta.crossunder(k1, obLevel)
[stN0, stQ0] = f_wfStats(stBuyDual)
[stN1, stQ1] = f_wfStats(stBuySing)
var int stSel = 1
stSel := f_wfScore(stN0, stQ0) > math.max(f_wfScore(stN1, stQ1), -1.0e8) ? 0 : f_wfScore(stN1, stQ1) > -1.0e8 ? 1 : stSel
bool autoStoch = stochMode == "Auto (aktienspezifisch)"
dualStoch = autoStoch ? stSel == 0 : stochMode == "Dual (klassisch)"
string stName = dualStoch ? "Dual (klassisch)" : "Single (schnelle Linie)"
stochBuyEvt  = dualStoch ? stBuyDual : stBuySing
stochSellEvt = dualStoch ? stSellDual : stSellSing

// ══════════════════════════ 4) OPTIONAL: RSI ══════════════════════════
rsi = ta.rsi(close, 14)
rsiBuyEvt  = ta.crossover(rsi, 30)
rsiSellEvt = ta.crossunder(rsi, 70)

// ══════════ 5) MEAN REVERSION (4. Komponente — Episoden-Logik v2) ══════════
// Identische Logik wie der Stillhalter Mean Reversion (intern kalibriert):
// Eine Ueberdehnungs-Episode jenseits der Schwelle wird verfolgt; Signal,
// sobald der Z-Score um den kalibrierten Anteil der Episodentiefe
// abgeprallt ist. Bereinigung: eine Wende = ein Signal (nur eine hoehere
// Stufe schlaegt innerhalb des Fensters noch durch).
mrMa = ta.sma(close, mrLen)
mrSd = ta.stdev(close, mrLen)
zRaw = mrSd != 0 ? (close - mrMa) / mrSd : 0.0
zS   = ta.ema(zRaw, 3)
mrThr   = 0.75
mrReb   = 30.0
mrNoise = 30

var bool  mrArmB   = false
var float mrExtB   = 0.0
var int   mrExtBarB = 0
if zS < -mrThr
    if mrArmB
        if zS < mrExtB
            mrExtB := zS
            mrExtBarB := bar_index
    else if mrExtB == 0.0 or zS < mrExtB
        mrArmB := true
        mrExtB := mrExtB == 0.0 ? zS : math.min(mrExtB, zS)
        mrExtBarB := bar_index
else if not mrArmB
    mrExtB := 0.0
bool mrBuyRaw = mrArmB and zS >= mrExtB * (1 - mrReb / 100)
int  mrStgB   = mrBuyRaw ? (-mrExtB >= 3.0 ? 3 : -mrExtB >= 2.0 ? 2 : 1) : 0
if mrBuyRaw
    mrArmB := false

var bool  mrArmS   = false
var float mrExtS   = 0.0
var int   mrExtBarS = 0
if zS > mrThr
    if mrArmS
        if zS > mrExtS
            mrExtS := zS
            mrExtBarS := bar_index
    else if mrExtS == 0.0 or zS > mrExtS
        mrArmS := true
        mrExtS := mrExtS == 0.0 ? zS : math.max(mrExtS, zS)
        mrExtBarS := bar_index
else if not mrArmS
    mrExtS := 0.0
bool mrSellRaw = mrArmS and zS <= mrExtS * (1 - mrReb / 100)
int  mrStgS    = mrSellRaw ? (mrExtS >= 3.0 ? 3 : mrExtS >= 2.0 ? 2 : 1) : 0
if mrSellRaw
    mrArmS := false

var int mrLastBB   = -100000
var int mrLastBStg = 0
var int mrLastSB   = -100000
var int mrLastSStg = 0
bool mrSigUp = mrStgB > 0 and (bar_index - mrLastBB > mrNoise or mrStgB > mrLastBStg)
bool mrSigDn = mrStgS > 0 and (bar_index - mrLastSB > mrNoise or mrStgS > mrLastSStg)
if mrSigUp
    mrLastBB   := bar_index
    mrLastBStg := mrStgB
if mrSigDn
    mrLastSB   := bar_index
    mrLastSStg := mrStgS
mrBuyEvt  = useMR and mrSigUp
mrSellEvt = useMR and mrSigDn

// ── MR-ANZEIGE ──────────────────────────────────────────────────────────────
// Overlay AUS: kleine farbige Punkte am Wende-Signal (wie bisher).
// Overlay AN: komplette Optik des Einzel-Indikators — Mittellinie,
// Abweichungs-Baender mit Fuellung, weisse ⚡-Dreiecke (Staerke ueber
// Transparenz), 🎯-Pivot-Punkte rueckwirkend am Extrem + Live-Vorschau.
plotshape(useMR and not showMrViz and mrSigUp,  "MR Wende UP",   shape.circle, location.belowbar,
     color.new(colUp, 30),   size = size.tiny, display = display.pane)
plotshape(useMR and not showMrViz and mrSigDn, "MR Wende DOWN", shape.circle, location.abovebar,
     color.new(colDown, 30), size = size.tiny, display = display.pane)
color mrUpTri = color.new(color.white, mrStgB == 3 ? 0 : mrStgB == 2 ? 35 : 65)
color mrDnTri = color.new(color.white, mrStgS == 3 ? 0 : mrStgS == 2 ? 35 : 65)
plotshape(showMrViz and mrSigUp,  "MR ⚡ UP",   shape.triangleup,   location.belowbar,
     mrUpTri, size = size.tiny, display = display.pane)
plotshape(showMrViz and mrSigDn, "MR ⚡ DOWN", shape.triangledown, location.abovebar,
     mrDnTri, size = size.tiny, display = display.pane)

// σ-Baender (identische Werte wie der Einzel-Indikator, SMA-Basis)
float mrU1 = mrMa + 1.0 * mrSd
float mrU2 = mrMa + 2.0 * mrSd
float mrU3 = mrMa + 3.0 * mrSd
float mrU4 = mrMa + 4.0 * mrSd
float mrL1 = mrMa - 1.0 * mrSd
float mrL2 = mrMa - 2.0 * mrSd
float mrL3 = mrMa - 3.0 * mrSd
float mrL4 = mrMa - 4.0 * mrSd
plot(showMrViz ? mrMa : na, "MR Mittellinie", color = color.new(color.white, 65), linewidth = 1, display = display.pane)
pMrU1 = plot(showMrViz ? mrU1 : na, "MR Band +1σ", color = color.new(colDown, 85), linewidth = 1, display = display.pane)
pMrU2 = plot(showMrViz ? mrU2 : na, "MR Band +2σ", color = color.new(colDown, 78), linewidth = 1, display = display.pane)
pMrU3 = plot(showMrViz ? mrU3 : na, "MR Band +3σ", color = color.new(colDown, 70), linewidth = 1, display = display.pane)
pMrU4 = plot(showMrViz ? mrU4 : na, "MR Band +4σ", color = color.new(colDown, 60), linewidth = 1, display = display.pane)
pMrL1 = plot(showMrViz ? mrL1 : na, "MR Band -1σ", color = color.new(colUp, 85), linewidth = 1, display = display.pane)
pMrL2 = plot(showMrViz ? mrL2 : na, "MR Band -2σ", color = color.new(colUp, 78), linewidth = 1, display = display.pane)
pMrL3 = plot(showMrViz ? mrL3 : na, "MR Band -3σ", color = color.new(colUp, 70), linewidth = 1, display = display.pane)
pMrL4 = plot(showMrViz ? mrL4 : na, "MR Band -4σ", color = color.new(colUp, 60), linewidth = 1, display = display.pane)
fill(pMrU1, pMrU2, color = color.new(colDown, 98))
fill(pMrU2, pMrU3, color = color.new(colDown, 97))
fill(pMrU3, pMrU4, color = color.new(colDown, 95))
fill(pMrL1, pMrL2, color = color.new(colUp, 98))
fill(pMrL2, pMrL3, color = color.new(colUp, 97))
fill(pMrL3, pMrL4, color = color.new(colUp, 95))

// 🎯 Pivot-Punkte: exaktes Z-Extrem, rueckwirkend bestaetigt (wie der
// Einzel-Indikator, inkl. Signal-Bereinigung)
float mrPh = ta.pivothigh(zS, 4, 4)
float mrPl = ta.pivotlow(zS, 4, 4)
bool mrPivBuyRaw  = not na(mrPl) and mrPl < -mrThr
bool mrPivSellRaw = not na(mrPh) and mrPh >  mrThr
int  mrPivStgB = mrPivBuyRaw  ? (-mrPl >= 3.0 ? 3 : -mrPl >= 2.0 ? 2 : 1) : 0
int  mrPivStgS = mrPivSellRaw ? (mrPh  >= 3.0 ? 3 : mrPh  >= 2.0 ? 2 : 1) : 0
var int mrLPBB   = -100000
var int mrLPBStg = 0
var int mrLPSB   = -100000
var int mrLPSStg = 0
bool mrPivBuy  = mrPivStgB > 0 and (bar_index - mrLPBB > mrNoise or mrPivStgB > mrLPBStg)
bool mrPivSell = mrPivStgS > 0 and (bar_index - mrLPSB > mrNoise or mrPivStgS > mrLPSStg)
if mrPivBuy
    mrLPBB   := bar_index
    mrLPBStg := mrPivStgB
if mrPivSell
    mrLPSB   := bar_index
    mrLPSStg := mrPivStgS
plotshape(showMrViz and mrPivBuy,  "MR 🎯 Extrem unten", shape.circle, location.belowbar,
     color.new(colUp, 40),  size = size.small, offset = -4, display = display.pane)
plotshape(showMrViz and mrPivSell, "MR 🎯 Extrem oben",  shape.circle, location.abovebar,
     color.new(colDown, 40), size = size.small, offset = -4, display = display.pane)

// 🎯 Pivot-VORSCHAU: durchsichtiger Punkt am bisherigen Episoden-Extrem,
// solange die Episode laeuft (wie der Einzel-Indikator)
var label mrPvB = na
var label mrPvS = na
if barstate.islast
    label.delete(mrPvB)
    label.delete(mrPvS)
    if showMrViz and mrArmB
        mrPvB := label.new(mrExtBarB, na, "", xloc = xloc.bar_index, yloc = yloc.belowbar,
             style = label.style_circle, color = color.new(colUp, 78), size = size.tiny)
    if showMrViz and mrArmS
        mrPvS := label.new(mrExtBarS, na, "", xloc = xloc.bar_index, yloc = yloc.abovebar,
             style = label.style_circle, color = color.new(colDown, 78), size = size.tiny)

// ══════════════════════════ ADX (14) — optionaler Filter ══════════════════════════
tr_     = math.max(math.max(high - low, math.abs(high - close[1])), math.abs(low - close[1]))
plusDM  = high - high[1] > low[1] - low ? math.max(high - high[1], 0) : 0
minusDM = low[1] - low  > high - high[1] ? math.max(low[1] - low, 0) : 0
sTR     = ta.rma(tr_, 14)
diPlus  = 100 * ta.rma(plusDM, 14)  / sTR
diMinus = 100 * ta.rma(minusDM, 14) / sTR
dx      = (diPlus + diMinus) != 0 ? 100 * math.abs(diPlus - diMinus) / (diPlus + diMinus) : 0
adx     = ta.rma(dx, 14)
adxOK   = not adxFilter or adx > 20
atr14   = ta.atr(14)

// ══════════ R-ANKER (Stillhalter Retracements) + TREPPEN-SPEICHER ══════════
// Anker 0 x nachgefuehrtes Allzeithoch (inkl. Docht). Tiefe Historie aus
// den Monatsdaten (bestaetigte Monate, kein Repaint); das Chart-Fenster
// deckt den aktuellen Monat ab. Interne Zuordnung NUR hier im Quellcode:
// R0=0 · R1=0.236 · R2=0.382 · R3=0.5 · R4=0.618 · R5=0.786/0.764 ·
// R6=1.0 (ATH) · R7=1.618 · R8=2.618 · R9=4.236 · R10=6.854.
f_rAnchor() =>
    var float hh = na
    hh := na(hh) ? high : math.max(hh, high)
    hh[1]
rAthHist = request.security(syminfo.tickerid, "M", f_rAnchor(), lookahead = barmerge.lookahead_on)
var float rAthLoc = na
rAthLoc := na(rAthLoc) ? high : math.max(rAthLoc, high)
float rAth = math.max(nz(rAthHist, rAthLoc), rAthLoc)
float rR5v = retrVariant == "Variante B (Spiegel)" ? 0.764 : 0.786

// Treppen-Speicher: (Kerze, Hoch) bei jedem neuen Allzeithoch — die
// Grundlage der historischen Level-Treppen (gezeichnet als Polylines,
// die weder Plot-Limit noch Chart-Skala belasten)
var array<int>   rStepX = array.new_int()
var array<float> rStepV = array.new_float()
int rNSt = array.size(rStepV)
if rNSt == 0 or rAth > array.get(rStepV, rNSt - 1)
    if rNSt > 0 and array.get(rStepX, rNSt - 1) == bar_index
        array.set(rStepV, rNSt - 1, rAth)
    else
        array.push(rStepX, bar_index)
        array.push(rStepV, rAth)
        if array.size(rStepV) > 4000
            array.shift(rStepX)
            array.shift(rStepV)

// ══════════ 6) QUALITAET DER UNTERSTUETZUNG (5. Komponente, optional) ══════════
// Steht auf UP, wenn das Kerzentief direkt an einem R-Level arbeitet
// (Toleranz x ATR14) — optional nur mit anziehendem Volumen. DOWN
// spiegelbildlich am R-Deckel ueber dem Kurs. Historisch korrekt ueber
// die Treppen-Serie (rAth je Kerze). KEIN eigener Ausloeser: Die
// Komponente veredelt die Timing-Signale der anderen vier.
float qsTol    = qsTolMult * atr14
float qsVolAvg = ta.sma(volume, 50)
bool  qsVolOK  = qsVolAvg > 0 and volume >= 1.2 * qsVolAvg
var float[] qsRatios = array.from(0.236, 0.382, 0.5, 0.618, rR5v, 1.0, 1.618, 2.618, 4.236, 6.854)
bool qsNearLo = false
bool qsNearHi = false
if useQS
    for qi = 0 to array.size(qsRatios) - 1
        float qLvl = rAth * array.get(qsRatios, qi)
        if math.abs(low - qLvl) <= qsTol
            qsNearLo := true
        if math.abs(high - qLvl) <= qsTol
            qsNearHi := true
bool qsBuyRaw  = useQS and qsNearLo and (not qsNeedVol or qsVolOK)
bool qsSellRaw = useQS and qsNearHi and (not qsNeedVol or qsVolOK)

// ══════════════════════════ KONFLUENZ-BEWERTUNG ══════════════════════════
sinceTrendBuy  = nz(ta.barssince(trendBuyEvt),  99999)
sinceMacdBuy   = nz(ta.barssince(macdBuyEvt),   99999)
sinceStochBuy  = nz(ta.barssince(stochBuyEvt),  99999)
sinceRsiBuy    = nz(ta.barssince(rsiBuyEvt),    99999)
sinceTrendSell = nz(ta.barssince(trendSellEvt), 99999)
sinceMacdSell  = nz(ta.barssince(macdSellEvt),  99999)
sinceStochSell = nz(ta.barssince(stochSellEvt), 99999)
sinceRsiSell   = nz(ta.barssince(rsiSellEvt),   99999)
sinceMrBuy     = nz(ta.barssince(mrBuyEvt),      99999)
sinceMrSell    = nz(ta.barssince(mrSellEvt),     99999)
sinceQsBuy     = nz(ta.barssince(qsBuyRaw),      99999)
sinceQsSell    = nz(ta.barssince(qsSellRaw),     99999)

trendBuyOK = useTrend and bullTrend and sinceTrendBuy < confWin
macdBuyOK  = useMACD and (macdFrueh ? hist > hist[1] : hist > 0)  and sinceMacdBuy  < confWin
stochBuyOK = useStoch and sinceStochBuy < confWin
rsiBuyOK   = useRSI and sinceRsiBuy < confWin
mrBuyOK    = useMR and sinceMrBuy < confWin
qsBuyOK    = useQS and sinceQsBuy < confWin

trendSellOK = useTrend and bearTrend and sinceTrendSell < confWin
macdSellOK = useMACD and (macdFrueh ? hist < hist[1] : hist < 0)  and sinceMacdSell < confWin
stochSellOK = useStoch and sinceStochSell < confWin
rsiSellOK   = useRSI and sinceRsiSell < confWin
mrSellOK   = useMR and sinceMrSell < confWin
qsSellOK   = useQS and sinceQsSell < confWin

nComp = (useTrend ? 1 : 0) + (useMACD ? 1 : 0) + (useStoch ? 1 : 0)
      + (useRSI ? 1 : 0) + (useMR ? 1 : 0) + (useQS ? 1 : 0)

buyScore  = (trendBuyOK ? 1 : 0) + (macdBuyOK ? 1 : 0) + (stochBuyOK ? 1 : 0)
          + (rsiBuyOK ? 1 : 0)  + (mrBuyOK ? 1 : 0)  + (qsBuyOK ? 1 : 0)
sellScore = (trendSellOK ? 1 : 0) + (macdSellOK ? 1 : 0) + (stochSellOK ? 1 : 0)
          + (rsiSellOK ? 1 : 0)  + (mrSellOK ? 1 : 0)  + (qsSellOK ? 1 : 0)

// Die Unterstuetzungs-Qualitaet loest selbst KEIN Dreieck aus — nur die
// AKTIVIERTEN Timing-Komponenten koennen den Moment setzen
buyEvtNow  = (useTrend and trendBuyEvt)  or (useMACD and macdBuyEvt)  or (useStoch and stochBuyEvt)
      or (useRSI and rsiBuyEvt)  or mrBuyEvt
sellEvtNow = (useTrend and trendSellEvt) or (useMACD and macdSellEvt) or (useStoch and stochSellEvt)
      or (useRSI and rsiSellEvt) or mrSellEvt

buyTrigger  = buyEvtNow  and buyScore  >= minScore and adxOK
sellTrigger = sellEvtNow and sellScore >= minScore and adxOK

// 2 sichtbar unterscheidbare Stufen:
// VOLLE Konfluenz = kraeftiges Dreieck · schwaechere Stufe = transparent
buyFull  = buyTrigger  and buyScore  >= nComp
buyWeak  = buyTrigger  and buyScore  <  nComp
sellFull = sellTrigger and sellScore >= nComp
sellWeak = sellTrigger and sellScore <  nComp
colUpW   = color.new(colUp,   weakTransp)
colDownW = color.new(colDown, weakTransp)

// ══════════════════════════ DREIECKE ══════════════════════════
// Ein Dreieck je Richtung — volle Konfluenz kraeftig, schwaechere Stufe
// transparent ('in Entstehung'). Die Beschriftung kommt als Label
// (zaehlt nicht gegen das Plot-Limit, identische Optik).
color triUpClr = buyFull  ? colUp   : colUpW
color triDnClr = sellFull ? colDown : colDownW
float triUpY = low  * (1 - triOffPct / 100)
float triDnY = high * (1 + triOffPct / 100)
plotshape(buyTrigger ? triUpY : na,  "Confluence UP",   shape.triangleup,   location.absolute,
     triUpClr, size = size.small, display = display.pane)
plotshape(sellTrigger ? triDnY : na, "Confluence DOWN", shape.triangledown, location.absolute,
     triDnClr, size = size.small, display = display.pane)
if barstate.isconfirmed and labelTxt != "Ohne Text"
    string triTxtB = labelTxt == "UP/DOWN" ? "UP" : labelTxt == "BULL/BEAR" ? "BULL" : labelTxt == "PUT/CALL" ? "PUT" : "BUY"
    string triTxtS = labelTxt == "UP/DOWN" ? "DOWN" : labelTxt == "BULL/BEAR" ? "BEAR" : labelTxt == "PUT/CALL" ? "CALL" : "SELL"
    if buyTrigger
        label.new(bar_index, triUpY, "\n" + triTxtB, style = label.style_none,
             textcolor = color.white, size = size.small)
    if sellTrigger
        label.new(bar_index, triDnY, triTxtS + "\n", style = label.style_none,
             textcolor = color.white, size = size.small)

// dezentes Trend-Band (Statuszeile bleibt sauber: display.pane)
pF = plot(trendFast, "Trend Fast", color = color.new(color.white, 100), display = display.pane, editable = false)
pS = plot(trendSlow, "Trend Slow", color = color.new(color.white, 100), display = display.pane, editable = false)
fill(pF, pS, color = showTrendBand ? (bullTrend ? colTrendUp : colTrendDown) : na, title = "Trend Band")

// ══════════ EMA 20 / 50 / 100 / 200 (dynamische Unterstützung/Widerstand) ══════════
ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
ema100 = ta.ema(close, 100)
ema200 = ta.ema(close, 200)
plot(showEma20  ? ema20  : na, "EMA 20",  color = color.new(emaClr20, 30), linewidth = 1, display = display.pane)
plot(showEma50  ? ema50  : na, "EMA 50",  color = color.new(emaClr50, 0),  linewidth = 2, display = display.pane)
plot(showEma100 ? ema100 : na, "EMA 100", color = color.new(emaClr100, 30), linewidth = 1, display = display.pane)
plot(showEma200 ? ema200 : na, "EMA 200", color = color.new(emaClr200, 0),  linewidth = 2, display = display.pane)

// ══════════ R-LEVEL: TREPPEN-POLYLINES + LABELS ══════════
// Komplette Historie wie im eigenstaendigen Stillhalter Retracements:
// Die Level springen nur bei neuem Allzeithoch und laufen aus der
// Vergangenheit mit. Polylines zaehlen nicht gegen das Plot-Limit und
// beeinflussen die Chart-Skala nicht (ruhige Skala bleibt).
color cR6 = color.white
color cR5 = #26C6DA
color cR4 = #00C853
color cR3 = #FFD600
color cR2 = #FF9100
color cR1 = #FF1744
color cR0 = color.gray
color cRx = #AB47BC

var array<polyline> rPls  = array.new<polyline>()
var array<label>    rLbls = array.new<label>()
var int   rDrawnBar = -1
var float rDrawnAth = na
if barstate.islast
    // Level-Satz (Reihenfolge: oben nach unten)
    float[]  rrat = array.from(1.0, rR5v, 0.618, 0.5, 0.382, 0.236, 0.0)
    string[] rnm  = array.from("R6", "R5", "R4", "R3", "R2", "R1", "R0")
    string[] rrt  = array.from("1.000", str.tostring(rR5v, "0.000"), "0.618", "0.500", "0.382", "0.236", "0.000")
    color[]  rcl  = array.from(cR6, cR5, cR4, cR3, cR2, cR1, cR0)
    int[]    rtp  = array.from(20, 20, 20, 30, 30, 30, 50)
    if showRetrExt
        array.unshift(rrat, 1.618), array.unshift(rnm, "R7"),  array.unshift(rrt, "1.618"), array.unshift(rcl, cRx), array.unshift(rtp, 40)
        array.unshift(rrat, 2.618), array.unshift(rnm, "R8"),  array.unshift(rrt, "2.618"), array.unshift(rcl, cRx), array.unshift(rtp, 50)
        array.unshift(rrat, 4.236), array.unshift(rnm, "R9"),  array.unshift(rrt, "4.236"), array.unshift(rcl, cRx), array.unshift(rtp, 60)
        array.unshift(rrat, 6.854), array.unshift(rnm, "R10"), array.unshift(rrt, "6.854"), array.unshift(rcl, cRx), array.unshift(rtp, 70)
    // Beschriftungen bei jeder Aktualisierung erneuern (Abstand in %)
    while array.size(rLbls) > 0
        label.delete(array.pop(rLbls))
    if showRetr
        for ri = 0 to array.size(rrat) - 1
            float rlvV = rAth * array.get(rrat, ri)
            string rTxt = array.get(rnm, ri)
                 + (showRetrRatio ? " · " + array.get(rrt, ri) : "")
                 + " — " + str.tostring(rlvV, format.mintick)
                 + " · " + (rlvV >= close ? "+" : "") + str.tostring((rlvV / close - 1) * 100, "#.#") + "%"
            array.push(rLbls, label.new(bar_index + 8, rlvV, rTxt,
                 style = label.style_label_left, color = color.new(color.black, 100),
                 textcolor = array.get(rcl, ri), size = size.small))
    // Treppen nur neu zeichnen, wenn eine neue Kerze oder ein neues Hoch kam
    if bar_index != rDrawnBar or rAth != rDrawnAth
        rDrawnBar := bar_index
        rDrawnAth := rAth
        while array.size(rPls) > 0
            polyline.delete(array.pop(rPls))
        if showRetr
            // Zeichen-Objekte koennen max. ~9999 Kerzen zurueck —
            // aeltere Stufen werden am Rand zusammengefasst
            int rMinX = bar_index - math.min(bar_index, 9500)
            int nSt2  = array.size(rStepV)
            for ri = 0 to array.size(rrat) - 1
                float rr = array.get(rrat, ri)
                array<chart.point> rPts = array.new<chart.point>()
                for si = 0 to nSt2 - 1
                    int x1s = si < nSt2 - 1 ? array.get(rStepX, si + 1) : bar_index
                    if x1s >= rMinX
                        int   x0s = math.max(array.get(rStepX, si), rMinX)
                        float vv  = array.get(rStepV, si) * rr
                        array.push(rPts, chart.point.from_index(x0s, vv))
                        array.push(rPts, chart.point.from_index(x1s, vv))
                if array.size(rPts) >= 2
                    array.push(rPls, polyline.new(rPts,
                         line_color = color.new(array.get(rcl, ri), array.get(rtp, ri)),
                         line_width = 1))

// ══════════════ MARKANTE S/R-PIVOTS (Basis der Options-Zonen) ══════════════
// Pivots (mit Zeitstempel) sammeln; ein Level ist markant, wenn ≥ minTouch
// Pivots innerhalb der Cluster-Toleranz davon liegen.
var array<float> pivLows  = array.new_float()
var array<int>   pivLowT  = array.new_int()
var array<float> pivHighs = array.new_float()
var array<int>   pivHighT = array.new_int()
// Für Optionen zählt der KÖRPER der Kerze (Open/Close) — Dochte sind oft
// nur kurzes Überschießen (per Input umschaltbar).
srcLoPiv = useBody ? math.min(open, close) : low
srcHiPiv = useBody ? math.max(open, close) : high
pl_ = ta.pivotlow(srcLoPiv,  pivLb, pivLb)
ph_ = ta.pivothigh(srcHiPiv, pivLb, pivLb)
if not na(pl_)
    array.push(pivLows, pl_)
    array.push(pivLowT, time[pivLb])
    if array.size(pivLows) > 300
        array.shift(pivLows)
        array.shift(pivLowT)
if not na(ph_)
    array.push(pivHighs, ph_)
    array.push(pivHighT, time[pivLb])
    if array.size(pivHighs) > 300
        array.shift(pivHighs)
        array.shift(pivHighT)

// ══════════════ VOLUMENPROFIL (lokales Tief → heute) · POC/VAH/VAL ══════════════
// Wie TradingViews eigenes Volume Profile wird aus INTRABAR-Daten einer
// feineren Zeitebene gerechnet (nicht aus den groben Kerzen-Spannen) —
// das ist der Grund, warum Kerzen-basierte Nachbauten von TVs Werten
// abweichen. Für alte Kerzen ohne Intrabar-Daten: Spannen-Näherung.
ltfAuto = timeframe.isintraday ? (timeframe.multiplier >= 120 ? "15" : timeframe.multiplier >= 30 ? "5" : "1") : "60"
ltfStr  = vpLtf == "Auto" ? ltfAuto : vpLtf
[ibC, ibV] = request.security_lower_tf(syminfo.tickerid, ltfStr, [close, volume])

var array<float> ibP   = array.new_float()   // Intrabar-Preise
var array<float> ibVol = array.new_float()   // Intrabar-Volumen
var array<int>   ibBar = array.new_int()     // zugehörige Chart-Kerze
var array<bool>  ibHas = array.new_bool()    // je Chart-Kerze: Intrabar-Daten da?
array.push(ibHas, array.size(ibC) > 0)
if array.size(ibHas) > 450
    array.shift(ibHas)
if array.size(ibC) > 0
    for i = 0 to array.size(ibC) - 1
        array.push(ibP,   array.get(ibC, i))
        array.push(ibVol, array.get(ibV, i))
        array.push(ibBar, bar_index)
while array.size(ibP) > 30000
    array.shift(ibP)
    array.shift(ibVol)
    array.shift(ibBar)

lowestOff = -ta.lowestbars(low, vpLen)   // Kerzen seit dem lokalen Tief

var line  lnPoc = na
var line  lnVah = na
var line  lnVal = na
// VAH/VAL global merken → Bonus-Stern für Options-Zonen (Volumen-Bestätigung)
var float g_vahPx = na
var float g_valPx = na
if barstate.islast
    g_vahPx := na
    g_valPx := na
var label lbPoc = na
var label lbVah = na
var label lbVal = na

if barstate.islast and showVP and lowestOff > 5
    // Range bestimmen
    float rLo = low
    float rHi = high
    for i = 0 to lowestOff
        rLo := math.min(rLo, low[i])
        rHi := math.max(rHi, high[i])
    if rHi > rLo
        // Volumen je Preiszeile verteilen (anteilig über die Kerzenspanne)
        var array<float> rowsV = array.new_float()
        array.clear(rowsV)
        for r = 0 to vpRows - 1
            array.push(rowsV, 0.0)
        step_ = (rHi - rLo) / vpRows
        int startIx = bar_index - lowestOff
        // 1) Intrabar-Punkte des Zeitraums einsortieren (feine Verteilung wie TV)
        if array.size(ibP) > 0
            for j = 0 to array.size(ibP) - 1
                if array.get(ibBar, j) >= startIx
                    float pIB = math.max(rLo, math.min(rHi, array.get(ibP, j)))
                    int rIB = math.min(vpRows - 1, math.max(0, int(math.floor((pIB - rLo) / step_))))
                    array.set(rowsV, rIB, array.get(rowsV, rIB) + array.get(ibVol, j))
        // 2) Fallback nur für Kerzen OHNE Intrabar-Daten: Spanne anteilig verteilen
        for i = 0 to lowestOff
            bool hasIB = false
            int hIx = array.size(ibHas) - 1 - i
            if hIx >= 0
                hasIB := array.get(ibHas, hIx)
            if not hasIB
                bLo = low[i]
                bHi = high[i]
                bV  = volume[i]
                span = math.max(bHi - bLo, syminfo.mintick)
                for r = 0 to vpRows - 1
                    eLo = rLo + r * step_
                    eHi = eLo + step_
                    ov  = math.max(0.0, math.min(bHi, eHi) - math.max(bLo, eLo))
                    if ov > 0
                        array.set(rowsV, r, array.get(rowsV, r) + bV * ov / span)
        // POC + Value Area (expandiert vom POC zur volumenstärkeren Seite)
        int pocR = 0
        for r = 1 to vpRows - 1
            if array.get(rowsV, r) > array.get(rowsV, pocR)
                pocR := r
        float totV = 0.0
        for r = 0 to vpRows - 1
            totV += array.get(rowsV, r)
        float accV = array.get(rowsV, pocR)
        int loR = pocR
        int hiR = pocR
        // Value-Area-Expansion PAARWEISE (wie TradingViews Volume Profile):
        // es werden jeweils die nächsten ZWEI Zeilen oben vs. unten verglichen.
        while accV < vaPct / 100 * totV and (loR > 0 or hiR < vpRows - 1)
            upV = 0.0
            if hiR + 1 <= vpRows - 1
                upV += array.get(rowsV, hiR + 1)
            if hiR + 2 <= vpRows - 1
                upV += array.get(rowsV, hiR + 2)
            dnV = 0.0
            if loR - 1 >= 0
                dnV += array.get(rowsV, loR - 1)
            if loR - 2 >= 0
                dnV += array.get(rowsV, loR - 2)
            if (upV >= dnV and hiR < vpRows - 1) or loR <= 0
                steps = math.min(2, vpRows - 1 - hiR)
                for s_ = 1 to steps
                    accV += array.get(rowsV, hiR + s_)
                hiR += steps
            else
                steps = math.min(2, loR)
                for s_ = 1 to steps
                    accV += array.get(rowsV, loR - s_)
                loR -= steps
        pocPx = rLo + (pocR + 0.5) * step_
        vahPx = rLo + (hiR + 1) * step_
        valPx = rLo + loR * step_
        g_vahPx := vahPx
        g_valPx := valPx
        // Volumen-Balken rechts im freien Randbereich
        x1 = bar_index - lowestOff
        var array<box> vpBoxes = array.new<box>()
        if array.size(vpBoxes) > 0
            for b = 0 to array.size(vpBoxes) - 1
                box.delete(array.get(vpBoxes, b))
        array.clear(vpBoxes)
        if showVPBars
            float maxV = 0.0
            for r = 0 to vpRows - 1
                maxV := math.max(maxV, array.get(rowsV, r))
            if maxV > 0
                // Balken haengen RECHTS im freien Randbereich (ueberdecken
                // keine Kerzen); Zeilen mit Volumen bekommen mind. Breite 1
                int maxW = 25
                for r = 0 to vpRows - 1
                    float vRow = array.get(rowsV, r)
                    if vRow > 0
                        int wRow = math.max(1, int(vRow / maxV * maxW))
                        float yRowLo = rLo + r * step_
                        bool inVA = r >= loR and r <= hiR
                        color rowCol = r == pocR ? color.new(color.orange, 20) :
                             inVA ? color.new(#2962FF, 45) : color.new(color.gray, 70)
                        array.push(vpBoxes, box.new(bar_index + 2, yRowLo + step_, bar_index + 2 + wRow, yRowLo,
                             border_color = color.new(color.black, 100), bgcolor = rowCol))
        line.delete(lnPoc)
        line.delete(lnVah)
        line.delete(lnVal)
        label.delete(lbPoc)
        label.delete(lbVah)
        label.delete(lbVal)
        lnPoc := line.new(x1, pocPx, bar_index, pocPx, color = color.new(color.orange, 0),  width = 2)
        lnVah := line.new(x1, vahPx, bar_index, vahPx, color = color.new(color.orange, 45), style = line.style_dashed)
        lnVal := line.new(x1, valPx, bar_index, valPx, color = color.new(color.orange, 45), style = line.style_dashed)
        lbPoc := label.new(bar_index + 29, pocPx, "POC " + str.tostring(pocPx, format.mintick),
             style = label.style_label_left, color = color.new(color.orange, 80), textcolor = color.white, size = size.small)
        lbVah := label.new(bar_index + 29, vahPx, "VAH " + str.tostring(vahPx, format.mintick),
             style = label.style_label_left, color = color.new(color.orange, 88), textcolor = color.white, size = size.small)
        lbVal := label.new(bar_index + 29, valPx, "VAL " + str.tostring(valPx, format.mintick),
             style = label.style_label_left, color = color.new(color.orange, 88), textcolor = color.white, size = size.small)

// ══════════════ 🟢🔴 OPTIONS-ZONEN (immer sichtbar, anfängertauglich) ══════════════
// Kandidaten = ALLE Pivots (Hochs UND Tiefs) der letzten N Monate. Ein altes
// Hoch UNTER dem heutigen Kurs ist ein Seitenwechsel (Widerstand → neue
// Unterstützung) und zählt deshalb mit. Pivots innerhalb der Cluster-Toleranz
// verschmelzen zu EINER Zone — Doppel-/Tripel-Tiefs werden so automatisch
// zu starken Zonen. Regel: Put-Strike UNTER die grüne Box, Call-Strike ÜBER
// die rote Box. Näher am Kurs = mehr Prämie, daher gewinnt die
// nächstgelegene Zone, die stark genug ist.

f_countSince(array<float> arr, array<int> tArr, float lvl, float tol, int tMin) =>
    int cnt = 0
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            if math.abs(array.get(arr, i) - lvl) <= tol and array.get(tArr, i) >= tMin
                cnt += 1
    cnt

f_bandSince(array<float> arr, array<int> tArr, float lvl, float tol, int tMin, bool wantMin) =>
    float ext = lvl
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            v = array.get(arr, i)
            if math.abs(v - lvl) <= tol and array.get(tArr, i) >= tMin
                ext := wantMin ? math.min(ext, v) : math.max(ext, v)
    ext

f_starsTxt(int n) =>
    n >= 4 ? "★★★★" : n == 3 ? "★★★" : n == 2 ? "★★" : "★"

f_firstTouch(array<float> arr, array<int> tArr, float lvl, float tol, int tMin) =>
    int first = time
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            if math.abs(array.get(arr, i) - lvl) <= tol and array.get(tArr, i) >= tMin
                first := math.min(first, array.get(tArr, i))
    first

f_barTouches(float zLo, float zHi, float tol) =>
    // EHRLICHE Berührungszählung: Kerzen-Kontakte mit der Zone, wobei
    // aufeinanderfolgende Kerzen in der Zone als EINE Berührung zählen
    int cnt = 0
    bool inT = false
    int maxB = math.min(bar_index, 420)
    for i = 0 to maxB
        float pLo = useBody ? math.min(open[i], close[i]) : low[i]
        float pHi = useBody ? math.max(open[i], close[i]) : high[i]
        bool hit = pLo <= zHi + tol and pHi >= zLo - tol
        if hit and not inT
            cnt += 1
        inT := hit
    cnt

f_lastTouch(array<float> arr, array<int> tArr, float lvl, float tol) =>
    int last = 0
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            if math.abs(array.get(arr, i) - lvl) <= tol
                last := math.max(last, array.get(tArr, i))
    last

// Jüngstes Swing-Tief/-Hoch (noch KEIN bestätigter Pivot — die ersten pivLb
// Kerzen nach einem Umkehrpunkt existiert er offiziell noch nicht)
recLoY = ta.lowest(srcLoPiv,  pivLb + 5)
recHiY = ta.highest(srcHiPiv, pivLb + 5)

var array<box>   zBoxes  = array.new<box>()
var array<label> zLabels = array.new<label>()

if barstate.islast and showZones
    // alte Zeichnungen entfernen (Zonen werden je Update neu bestimmt)
    if array.size(zBoxes) > 0
        for i = 0 to array.size(zBoxes) - 1
            box.delete(array.get(zBoxes, i))
    if array.size(zLabels) > 0
        for i = 0 to array.size(zLabels) - 1
            label.delete(array.get(zLabels, i))
    array.clear(zBoxes)
    array.clear(zLabels)

    int   tMinZ = time - zoneMonths * 2629800000   // Monate → Millisekunden
    float tolZ  = zoneTolMult * atr14

    // Kandidaten-Levels: ALLE gespeicherten Pivots — die Aktualität (letzter
    // Test innerhalb des Rückblicks ODER aktueller Retest) wird je Kandidat
    // geprüft; die Stärke zählt über das gesamte Gedächtnis
    array<float> cands = array.new_float()
    if array.size(pivLows) > 0
        for i = 0 to array.size(pivLows) - 1
            array.push(cands, array.get(pivLows, i))
    if array.size(pivHighs) > 0
        for i = 0 to array.size(pivHighs) - 1
            array.push(cands, array.get(pivHighs, i))
    // Vorberechnung je Kandidat: Berührungen gesamt + Zeitpunkt des letzten Tests
    array<int> candN    = array.new_int()
    array<int> candLast = array.new_int()
    if array.size(cands) > 0
        for i = 0 to array.size(cands) - 1
            float cl = array.get(cands, i)
            array.push(candN, f_countSince(pivLows, pivLowT, cl, tolZ, 0) + f_countSince(pivHighs, pivHighT, cl, tolZ, 0))
            array.push(candLast, math.max(f_lastTouch(pivLows, pivLowT, cl, tolZ), f_lastTouch(pivHighs, pivHighT, cl, tolZ)))

    for side = 0 to 1                    // 0 = Put-Zonen (unten) · 1 = Call-Zonen (oben)
        bool  isSup     = side == 0
        float boundary  = na             // Außenkante der zuletzt gewählten Zone
        int   youngUsed = 0              // max. 1 ☆-Zone je Seite (kein Clutter)
        for z = 1 to zonesPerSide
            float best = na
            bool  bestYoung = false
            // EIN Durchlauf: der nächstgelegene RELEVANTE Level gewinnt —
            // stark (genug Berührungen) oder ☆ jung (max. 1 je Seite)
            if array.size(cands) > 0
                for i = 0 to array.size(cands) - 1
                    lvl = array.get(cands, i)
                    bool okSide = isSup ? lvl <= close - zoneDistMult * atr14 : lvl >= close + zoneDistMult * atr14
                    bool okGap = true
                    if not na(boundary)
                        okGap := isSup ? lvl <= boundary - zoneGapMult * atr14 : lvl >= boundary + zoneGapMult * atr14
                    if okSide and okGap
                        int nAll = array.get(candN, i)
                        bool retest = math.abs((isSup ? recLoY : recHiY) - lvl) <= tolZ
                        if retest
                            nAll += 1
                        bool aktuell  = array.get(candLast, i) >= tMinZ or retest
                        bool strongOk = nAll >= minTouch and aktuell
                        bool youngOk  = showYoung and youngUsed < 1 and aktuell
                        if strongOk or youngOk
                            if na(best) or (isSup ? lvl > best : lvl < best)
                                best := lvl
                                bestYoung := not strongOk
            // Jüngstes (unbestätigtes) Swing-Level als eigener ☆-Kandidat
            if showYoung and youngUsed < 1
                float recCand = isSup ? recLoY : recHiY
                bool okSideR = isSup ? recCand <= close - zoneDistMult * atr14 : recCand >= close + zoneDistMult * atr14
                bool okGapR = true
                if not na(boundary)
                    okGapR := isSup ? recCand <= boundary - zoneGapMult * atr14 : recCand >= boundary + zoneGapMult * atr14
                if okSideR and okGapR
                    if na(best) or (isSup ? recCand > best : recCand < best)
                        int nAllR = f_countSince(pivLows, pivLowT, recCand, tolZ, 0) + f_countSince(pivHighs, pivHighT, recCand, tolZ, 0) + 1
                        best := recCand
                        bestYoung := nAllR < minTouch
            if not na(best)
                if bestYoung
                    youngUsed += 1
                nLo = f_countSince(pivLows,  pivLowT,  best, tolZ, 0)
                nHi = f_countSince(pivHighs, pivHighT, best, tolZ, 0)
                bool retestB = math.abs((isSup ? recLoY : recHiY) - best) <= tolZ
                bool isYoung = bestYoung
                // Zonenband = Spanne aller Cluster-Mitglieder (mind. 0.15 ATR dick)
                float bLo = math.min(f_bandSince(pivLows, pivLowT, best, tolZ, 0, true), f_bandSince(pivHighs, pivHighT, best, tolZ, 0, true))
                float bHi = math.max(f_bandSince(pivLows, pivLowT, best, tolZ, 0, false), f_bandSince(pivHighs, pivHighT, best, tolZ, 0, false))
                if bHi - bLo < 0.15 * atr14
                    float midZ = (bHi + bLo) / 2
                    bLo := midZ - 0.075 * atr14
                    bHi := midZ + 0.075 * atr14
                // Breiten-Deckel: Zone hoechstens 0.6 x ATR14 dick —
                // symmetrisch um den Kern-Level geklemmt (praezise Strikes)
                if bHi - bLo > 0.6 * atr14
                    bLo := best - 0.3 * atr14
                    bHi := best + 0.3 * atr14
                // Berührungen ehrlich zählen (Kerzen-Cluster in der Zone) —
                // die reine Pivot-Zählung unterschätzte um Faktor ~4
                touches = math.max(f_barTouches(bLo, bHi, tolZ * 0.25), 1)
                // Sterne: ★ = 2 Berührungen · ★★ = 3+ · +★ Seitenwechsel ·
                // +★ Volumen (VAL/VAH) · +★ EMA-Bestätigung — max. ★★★★
                int stars = touches >= 3 ? 2 : 1
                bool roleRev = nLo > 0 and nHi > 0
                if roleRev
                    stars += 1
                float vaRef = isSup ? g_valPx : g_vahPx
                bool vaHit = not na(vaRef) and vaRef >= bLo - tolZ and vaRef <= bHi + tolZ
                if vaHit
                    stars += 1
                // EMA-Bestätigung: liegt eine der grossen EMAs in der Zone?
                string emaHitName = ""
                if ema50 >= bLo - tolZ and ema50 <= bHi + tolZ
                    emaHitName := "EMA 50"
                else if ema100 >= bLo - tolZ and ema100 <= bHi + tolZ
                    emaHitName := "EMA 100"
                else if ema200 >= bLo - tolZ and ema200 <= bHi + tolZ
                    emaHitName := "EMA 200"
                if emaHitName != ""
                    stars += 1
                stars := math.min(stars, 4)
                color zCol = isSup ? colUp : colDown
                // Zone über die GANZE betrachtete Periode: von der ersten
                // Berührung des Levels bis heute (xloc.bar_time)
                int firstT = math.min(f_firstTouch(pivLows, pivLowT, best, tolZ, 0),
                     f_firstTouch(pivHighs, pivHighT, best, tolZ, 0))
                array.push(zBoxes, box.new(firstT, bHi, time, bLo,
                     xloc = xloc.bar_time,
                     border_color = color.new(zCol, isYoung ? 60 : 35), border_width = 1,
                     bgcolor = color.new(zCol, isYoung ? 93 : z == 1 ? 82 : 90)))
                float strike = isSup ? bLo : bHi
                float otmPct = isSup ? (close - strike) / close * 100 : (strike - close) / close * 100
                // Label bewusst schlank: Richtung + Sterne + Strike-Kante —
                // exakte Zone & Begründung im Hover-Tooltip
                string txt = isSup ? "🟢 PUT-Zone " : "🔴 CALL-Zone "
                txt += isYoung ? "☆ jung" : f_starsTxt(stars)
                txt += isSup ? " · Strike ≤ " : " · Strike ≥ "
                txt += str.tostring(strike, format.mintick)
                txt += " (" + str.tostring(otmPct, "#.#") + "% OTM)"
                txt += " · " + str.tostring(touches) + "×"
                string tip = isYoung ? "☆ JUNGES LEVEL — erst 1× berührt bzw. noch nicht als Pivot bestätigt\n" : ""
                tip += isSup ? "Put-Strike unter " : "Call-Strike über "
                tip += str.tostring(strike, format.mintick)
                tip += " (" + str.tostring(otmPct, "#.#") + "% vom Kurs entfernt)"
                tip += "\nZone " + str.tostring(bLo, format.mintick) + " – " + str.tostring(bHi, format.mintick)
                tip += "\n" + str.tostring(touches) + "× berührt insgesamt"
                if retestB
                    tip += " (inkl. aktuellem Retest)"
                if roleRev
                    tip += isSup ? "\nSeitenwechsel: alter Widerstand = neue Unterstützung" : "\nSeitenwechsel: alte Unterstützung = neuer Widerstand"
                if vaHit
                    tip += isSup ? "\nVolumen-Bestätigung (VAL)" : "\nVolumen-Bestätigung (VAH)"
                if emaHitName != ""
                    tip += "\nEMA-Bestätigung (" + emaHitName + " liegt in der Zone)"
                tip += "\n★ = 2 Berührungen · ★★ = 3+ · +★ Seitenwechsel · +★ Volumen · +★ EMA (max. ★★★★)"
                array.push(zLabels, label.new(bar_index + 3, (bLo + bHi) / 2, txt,
                     style = label.style_label_left, color = color.new(zCol, 55),
                     textcolor = color.white, size = z == 1 ? size.normal : size.small,
                     tooltip = tip))
                boundary := isSup ? bLo : bHi

// ══════ BACKTEST — EINZEL-INDIKATOREN + KUMULIERTE KONFLUENZ ══════
// Obere Zeilen: jeder Indikator ALLEIN (sein eigenes Kauf-/Verkaufs-
// Ereignis). Untere Zeilen: KUMULIERT — mindestens 2/3/4/... Komponenten
// gleichzeitig (>=, nicht exakt). So ist direkt ablesbar, wie jede
// zusaetzliche Bestaetigung die Unsicherheit reduziert.
// Stillhalter: Short Put (Strike unter Area Low − Puffer am Kauf-Signal),
// Short Call (ueber Area High + Puffer am Verkaufs-Signal) oder beide;
// Verfall 1. Freitag nach >= minCalDays. ROI ueber die Praemien-Annahme
// (premPct % vom Strike je Trade), Verlust = Strike-Verletzung am
// Verfall; Win = Trade endet netto im Plus.
// Aktie: Long-Roundtrip je Zeile (Kauf-Signal -> Verkaufs-Signal).
// Ausfuehrung je nach Einstellung: naechste Eroeffnung (Bar Open) oder
// Schlusskurs der Signalkerze (Bar Close).
inWindow = time >= btFrom and time <= btTo

bool  refEng   = strikeRef == "Schlusskurs (eng)"
float btRefLo  = refEng ? close : ta.lowest(low, refLen)
float btRefHi  = refEng ? close : ta.highest(high, refLen)
bool  wantPut  = btSide != "Short Call"
bool  wantCall = btSide != "Short Put"
bool  aktMode  = btMode == "Aktie (Long)"
// 'Bar Open' = sofort am entstehenden Signal -> Ausfuehrung zum
// Schlusskurs der Signalkerze (Intrabar-Naeherung, siehe Tooltip)
bool  execClose = btEntry == "Bar Open — sofort am entstehenden Signal (intrabar)"

// Slots: 0 Trend · 1 MACD · 2 Stoch · 3 RSI · 4 MR · 5 Support-Qual. ·
// 6..10 kumuliert (Score >= 2 .. >= 6)
int NSLOT = 11
array<bool> slotBuy  = array.new_bool(NSLOT, false)
array<bool> slotSell = array.new_bool(NSLOT, false)
array.set(slotBuy, 0, useTrend and trendBuyEvt)
array.set(slotSell, 0, useTrend and trendSellEvt)
array.set(slotBuy, 1, useMACD and macdBuyEvt)
array.set(slotSell, 1, useMACD and macdSellEvt)
array.set(slotBuy, 2, useStoch and stochBuyEvt)
array.set(slotSell, 2, useStoch and stochSellEvt)
array.set(slotBuy, 3, useRSI and rsiBuyEvt)
array.set(slotSell, 3, useRSI and rsiSellEvt)
array.set(slotBuy, 4, useMR and mrSigUp)
array.set(slotSell, 4, useMR and mrSigDn)
array.set(slotBuy, 5, qsBuyRaw)
array.set(slotSell, 5, qsSellRaw)
for sc = 2 to 6
    array.set(slotBuy,  4 + sc, buyEvtNow  and adxOK and buyScore  >= sc)
    array.set(slotSell, 4 + sc, sellEvtNow and adxOK and sellScore >= sc)

// Kennzahlen je Zeile (Equity-basiert: Win = netto im Plus)
var array<int>   stTr = array.new_int(NSLOT, 0)
var array<int>   stWin = array.new_int(NSLOT, 0)
var array<float> stEq = array.new_float(NSLOT, na)
var array<float> stPk = array.new_float(NSLOT, 0.0)
var array<float> stDD = array.new_float(NSLOT, 0.0)
// Short-Put- / Short-Call-Slots (je Zeile max. 1 offen je Seite)
var array<bool>  spOn  = array.new_bool(NSLOT, false)
var array<float> spK   = array.new_float(NSLOT, na)
var array<int>   spX   = array.new_int(NSLOT, 0)
var array<float> spPr  = array.new_float(NSLOT, 0.0)
var array<bool>  spPd  = array.new_bool(NSLOT, false)
var array<float> spPdK = array.new_float(NSLOT, na)
var array<bool>  scOn  = array.new_bool(NSLOT, false)
var array<float> scK   = array.new_float(NSLOT, na)
var array<int>   scX   = array.new_int(NSLOT, 0)
var array<float> scPr  = array.new_float(NSLOT, 0.0)
var array<bool>  scPd  = array.new_bool(NSLOT, false)
var array<float> scPdK = array.new_float(NSLOT, na)
// Aktien-Slots
var array<bool>  akPB = array.new_bool(NSLOT, false)
var array<bool>  akPS = array.new_bool(NSLOT, false)
var array<bool>  akIn = array.new_bool(NSLOT, false)
var array<float> akEn = array.new_float(NSLOT, na)

f_book(int sl, float ret) =>
    float eqv = nz(array.get(stEq, sl), initialCapital) * (1 + ret)
    array.set(stEq, sl, eqv)
    float pk = math.max(math.max(array.get(stPk, sl), initialCapital), eqv)
    array.set(stPk, sl, pk)
    array.set(stDD, sl, math.max(array.get(stDD, sl), pk > 0 ? (pk - eqv) / pk * 100 : 0.0))
    array.set(stTr, sl, array.get(stTr, sl) + 1)
    if ret > 0
        array.set(stWin, sl, array.get(stWin, sl) + 1)

if enableBT
    if aktMode
        for sl = 0 to NSLOT - 1
            // Bar-Open-Modus: Pendings der Vorkerze zur Eröffnung ausführen
            if array.get(akPB, sl) and not array.get(akIn, sl)
                array.set(akIn, sl, true)
                array.set(akEn, sl, open)
                array.set(akPB, sl, false)
            if array.get(akPS, sl)
                if array.get(akIn, sl)
                    f_book(sl, (open - array.get(akEn, sl)) / array.get(akEn, sl))
                    array.set(akIn, sl, false)
                array.set(akPS, sl, false)
            // Neue Signale dieser Kerze
            if inWindow and array.get(slotBuy, sl) and not array.get(akIn, sl) and not array.get(akPB, sl)
                if execClose
                    array.set(akIn, sl, true)
                    array.set(akEn, sl, close)
                else
                    array.set(akPB, sl, true)
            if inWindow and array.get(slotSell, sl) and array.get(akIn, sl)
                if execClose
                    f_book(sl, (close - array.get(akEn, sl)) / array.get(akEn, sl))
                    array.set(akIn, sl, false)
                else
                    array.set(akPS, sl, true)
    else
        for sl = 0 to NSLOT - 1
            // 1) Offene Optionen am Verfall abrechnen (mit der beim
            //    Einstieg festgehaltenen Praemie)
            if array.get(spOn, sl) and time >= array.get(spX, sl)
                f_book(sl, array.get(spPr, sl) / 100 + math.min(0.0, close / array.get(spK, sl) - 1))
                array.set(spOn, sl, false)
            if array.get(scOn, sl) and time >= array.get(scX, sl)
                f_book(sl, array.get(scPr, sl) / 100 + math.min(0.0, 1 - close / array.get(scK, sl)))
                array.set(scOn, sl, false)
            // 2) Bar-Close-Modus: Pendings der Vorkerze jetzt eröffnen
            //    (Praemie zum Ausfuehrungszeitpunkt, S = Eroeffnungskurs)
            if array.get(spPd, sl)
                if not array.get(spOn, sl)
                    float kPd = array.get(spPdK, sl)
                    int   xPd = f_fridayAfter(time + minCalDays * 86400000)
                    array.set(spOn, sl, true)
                    array.set(spK, sl, kPd)
                    array.set(spX, sl, xPd)
                    array.set(spPr, sl, premConst ? premPct : f_optPremPct(open, kPd, hvEff, (xPd - time) / 86400000.0, true))
                array.set(spPd, sl, false)
            if array.get(scPd, sl)
                if not array.get(scOn, sl)
                    float kCd = array.get(scPdK, sl)
                    int   xCd = f_fridayAfter(time + minCalDays * 86400000)
                    array.set(scOn, sl, true)
                    array.set(scK, sl, kCd)
                    array.set(scX, sl, xCd)
                    array.set(scPr, sl, premConst ? premPct : f_optPremPct(open, kCd, hvEff, (xCd - time) / 86400000.0, false))
                array.set(scPd, sl, false)
            // 3) Neue Signale dieser Kerze
            if inWindow and wantPut and array.get(slotBuy, sl) and not array.get(spOn, sl) and not array.get(spPd, sl)
                float kP = btRefLo * (1 - strikeBufPct / 100)
                if execClose
                    int xPn = f_fridayAfter(time + minCalDays * 86400000)
                    array.set(spOn, sl, true)
                    array.set(spK, sl, kP)
                    array.set(spX, sl, xPn)
                    array.set(spPr, sl, premConst ? premPct : f_optPremPct(close, kP, hvEff, (xPn - time) / 86400000.0, true))
                else
                    array.set(spPd, sl, true)
                    array.set(spPdK, sl, kP)
            if inWindow and wantCall and array.get(slotSell, sl) and not array.get(scOn, sl) and not array.get(scPd, sl)
                float kC = btRefHi * (1 + strikeBufPct / 100)
                if execClose
                    int xCn = f_fridayAfter(time + minCalDays * 86400000)
                    array.set(scOn, sl, true)
                    array.set(scK, sl, kC)
                    array.set(scX, sl, xCn)
                    array.set(scPr, sl, premConst ? premPct : f_optPremPct(close, kC, hvEff, (xCn - time) / 86400000.0, false))
                else
                    array.set(scPd, sl, true)
                    array.set(scPdK, sl, kC)

// ── Kompakte Staffel-Tabelle oben rechts ──
var table bt = table.new(position.top_right, 5, 14, border_width = 1)

f_cell(int cCol, int cRow, string txt, bool hd) =>
    table.cell(bt, cCol, cRow, txt, text_color = color.white, text_size = size.small,
         bgcolor = hd ? color.new(color.black, 20) : na)

if barstate.islast and enableBT
    string hd0 = aktMode ? "Aktie (Long)" : wantPut and wantCall ? "Short Options" : wantPut ? "Short Put" : "Short Call"
    f_cell(0, 0, hd0, true)
    f_cell(1, 0, "n", true)
    f_cell(2, 0, "Win", true)
    f_cell(3, 0, "ROI", true)
    f_cell(4, 0, "Max DD", true)
    // Liste der aktiven Komponenten (fuer die Hover-Erklaerung der
    // kumulierten Zeilen: 'min. s von n' = BELIEBIGE s davon)
    string compList = (useTrend ? "Trend, " : "") + (useMACD ? "MACD, " : "")
         + (useStoch ? "Stochastik, " : "") + (useRSI ? "RSI, " : "")
         + (useMR ? "Mean Reversion, " : "") + (useQS ? "Support-Qual., " : "")
    compList := str.length(compList) > 2 ? str.substring(compList, 0, str.length(compList) - 2) : compList
    int rowI = 1
    for sl = 0 to NSLOT - 1
        bool showRow = (sl == 0 and useTrend) or (sl == 1 and useMACD) or (sl == 2 and useStoch)
             or (sl == 3 and useRSI) or (sl == 4 and useMR)
             or (sl == 5 and useQS) or (sl >= 6 and sl - 4 <= nComp)
        if showRow
            string nm = sl == 0 ? "Trend" : sl == 1 ? "MACD" : sl == 2 ? "Stoch" :
                 sl == 3 ? "RSI" : sl == 4 ? "MR" : sl == 5 ? "Supp." :
                 (sl - 4 == nComp ? "alle " + str.tostring(nComp) + " von " + str.tostring(nComp) :
                 "min. " + str.tostring(sl - 4) + " von " + str.tostring(nComp))
            string nmTip = sl < 6 ? "Nur dieser Indikator allein — sein eigenes Kauf-/Verkaufs-Signal, "
                      + "unabhängig von den anderen Komponenten." :
                 (sl - 4 == nComp ? "ALLE " + str.tostring(nComp) + " aktivierten Komponenten ("
                      + compList + ") stehen gleichzeitig in Trade-Richtung." :
                 "Mindestens " + str.tostring(sl - 4) + " der " + str.tostring(nComp)
                      + " aktivierten Komponenten (" + compList + ") stehen gleichzeitig in "
                      + "Trade-Richtung — egal WELCHE Kombination, kein fester Satz von "
                      + "Indikatoren. Die Zeilen darunter sind Teilmengen hiervon.")
            int   trS = array.get(stTr, sl)
            float wrS = trS > 0 ? array.get(stWin, sl) * 100.0 / trS : na
            float roS = not na(array.get(stEq, sl)) ? (array.get(stEq, sl) / initialCapital - 1) * 100 : na
            // Oe je Trade (geometrisch) — macht Zeilen mit unterschiedlich
            // vielen Trades fair vergleichbar (ROI ist aufgezinst ueber n)
            float avgT = trS > 0 and not na(roS) ? (math.pow(array.get(stEq, sl) / initialCapital, 1.0 / trS) - 1) * 100 : na
            table.cell(bt, 0, rowI, nm, text_color = color.white, text_size = size.small,
                 bgcolor = sl >= 6 ? color.new(color.black, 20) : na, tooltip = nmTip)
            f_cell(1, rowI, str.tostring(trS), false)
            f_cell(2, rowI, na(wrS) ? "–" : str.tostring(wrS, "#.#") + "%", false)
            table.cell(bt, 3, rowI, na(roS) ? "–" : str.tostring(roS, "#.#") + "%",
                 text_color = color.white, text_size = size.small,
                 tooltip = na(avgT) ? "" : "Ø je Trade: " + str.tostring(avgT, "#.##")
                      + "% (geometrisch über " + str.tostring(trS) + " Trades).\n"
                      + "Der ROI ist über alle Trades aufgezinst — Zeilen mit mehr "
                      + "Trades sammeln mechanisch mehr Prämie. Für den fairen "
                      + "Vergleich zwischen Zeilen den Ø je Trade nutzen.")
            f_cell(4, rowI, trS > 0 ? str.tostring(array.get(stDD, sl), "#.#") + "%" : "–", false)
            rowI += 1
    // kurze Regel-Zeile (nur Options-Modus)
    if not aktMode
        string refTxt = refEng ? "Close" : wantPut and wantCall ? "Area Lo/Hi" : wantPut ? "Area Low" : "Area High"
        string bufSgn = wantPut and wantCall ? "±" : wantPut ? "−" : "+"
        string premTxt = premConst ? "Präm. " + str.tostring(premPct, "#.#") + "%" :
             "Präm. Vol-Modell ×" + str.tostring(premIvMult, "#.#")
        f_cell(0, rowI, "Regel", false)
        table.cell(bt, 1, rowI, refTxt + " " + bufSgn + str.tostring(strikeBufPct, "#.#") + "% · 1.Fr ≥"
             + str.tostring(minCalDays) + "T · " + premTxt,
             text_color = color.new(color.white, 20), text_size = size.tiny, text_halign = text.align_left)
        table.merge_cells(bt, 1, rowI, 4, rowI)

// ══════ UNSICHERHEITS-KASKADE (Modell vs. gemessen) ══════
// Ueberlappungs-Zaehler: Anteil der Kauf-Signale einer Komponente, die
// innerhalb des Konfluenz-Fensters NACH einem Signal einer frueheren
// Komponente kamen (feste Reihenfolge: Trend, MACD, Stoch, RSI, MR,
// Support-Qual.). Das ist das Pendant zur Spalte 'Indicator Confluence'
// — hier aber GEMESSEN statt geschaetzt.
var array<int> ovN = array.new_int(6, 0)
var array<int> ovH = array.new_int(6, 0)
if enableBT and inWindow
    if useTrend and trendBuyEvt
        array.set(ovN, 0, array.get(ovN, 0) + 1)
    if useMACD and macdBuyEvt
        array.set(ovN, 1, array.get(ovN, 1) + 1)
        if useTrend and sinceTrendBuy < confWin
            array.set(ovH, 1, array.get(ovH, 1) + 1)
    if useStoch and stochBuyEvt
        array.set(ovN, 2, array.get(ovN, 2) + 1)
        if (useTrend and sinceTrendBuy < confWin) or (useMACD and sinceMacdBuy < confWin)
            array.set(ovH, 2, array.get(ovH, 2) + 1)
    if useRSI and rsiBuyEvt
        array.set(ovN, 3, array.get(ovN, 3) + 1)
        if (useTrend and sinceTrendBuy < confWin) or (useMACD and sinceMacdBuy < confWin) or (useStoch and sinceStochBuy < confWin)
            array.set(ovH, 3, array.get(ovH, 3) + 1)
    if useMR and mrSigUp
        array.set(ovN, 4, array.get(ovN, 4) + 1)
        if (useTrend and sinceTrendBuy < confWin) or (useMACD and sinceMacdBuy < confWin) or (useStoch and sinceStochBuy < confWin) or (useRSI and sinceRsiBuy < confWin)
            array.set(ovH, 4, array.get(ovH, 4) + 1)
    if useQS and qsBuyRaw
        array.set(ovN, 5, array.get(ovN, 5) + 1)
        if (useTrend and sinceTrendBuy < confWin) or (useMACD and sinceMacdBuy < confWin) or (useStoch and sinceStochBuy < confWin) or (useRSI and sinceRsiBuy < confWin) or (useMR and sinceMrBuy < confWin)
            array.set(ovH, 5, array.get(ovH, 5) + 1)

var table kc = table.new(position.bottom_left, 6, 8, border_width = 1)
if barstate.islast and enableBT and showCascade
    color kBg = color.new(color.black, 20)
    table.cell(kc, 0, 0, "Kaskade", text_color = color.white, text_size = size.small, bgcolor = kBg,
         tooltip = "Unsicherheits-Kaskade: Win = gemessene Trefferquote der Komponente "
              + "allein (Short-Put-Backtest, Regeln wie die Staffel-Tabelle). "
              + "MODELL = kumulierte Konfidenz nach dem Multiplikationsprinzip "
              + "(Rest-Unsicherheit × Rest-Unsicherheit, gedämpft um die gemessene "
              + "Überlappung) — gilt nur bei unabhängigen Fehlern. GEMESSEN = echte "
              + "Win Rate der 'min. k von n'-Staffel. Lücke = Korrelation der Fehler.")
    table.cell(kc, 1, 0, "Win",      text_color = color.white, text_size = size.small, bgcolor = kBg)
    table.cell(kc, 2, 0, "Unsich.",  text_color = color.white, text_size = size.small, bgcolor = kBg)
    table.cell(kc, 3, 0, "Überl.",   text_color = color.white, text_size = size.small, bgcolor = kBg,
         tooltip = "Gemessene Signal-Überlappung: Anteil der Signale dieser Komponente, "
              + "die innerhalb des Konfluenz-Fensters nach einem Signal einer "
              + "FRÜHEREN Zeile kamen (Pendant zu 'Indicator Confluence' — gemessen "
              + "statt geschätzt).")
    table.cell(kc, 4, 0, "Modell",   text_color = color.white, text_size = size.small, bgcolor = kBg)
    table.cell(kc, 5, 0, "Gemessen", text_color = color.white, text_size = size.small, bgcolor = kBg,
         tooltip = "Echte Trefferquote, wenn wirklich k Komponenten gleichzeitig "
              + "standen ('min. k von n' der Staffel-Tabelle, beliebige Kombination). "
              + "Zeile 1 = die Komponente allein.")
    float cumU = 100.0
    bool  cumOk = false
    int   kPos = 0
    int   kRow = 1
    for c = 0 to 5
        bool actC = c == 0 ? useTrend : c == 1 ? useMACD : c == 2 ? useStoch : c == 3 ? useRSI : c == 4 ? useMR : useQS
        if actC
            kPos += 1
            string nmC = c == 0 ? "Trend" : c == 1 ? "MACD" : c == 2 ? "Stoch" : c == 3 ? "RSI" : c == 4 ? "MR" : "Supp."
            int   nC  = array.get(stTr, c)
            float wrC = nC > 0 ? array.get(stWin, c) * 100.0 / nC : na
            float ovC = kPos == 1 ? 0.0 : (array.get(ovN, c) > 0 ? array.get(ovH, c) * 100.0 / array.get(ovN, c) : na)
            bool  okC = nC >= 10 and not na(wrC)
            if okC
                if not cumOk
                    cumU  := 100.0 - wrC
                    cumOk := true
                else
                    cumU := cumU * (1 - wrC / 100 * (1 - nz(ovC, 0) / 100))
            // GEMESSEN: Zeile 1 = eigene WR · ab Zeile 2 = 'min. k von n'
            float measWr = na
            int   measN  = 0
            if kPos == 1
                measWr := wrC
                measN  := nC
            else if kPos <= 6
                measN  := array.get(stTr, 4 + kPos)
                measWr := measN > 0 ? array.get(stWin, 4 + kPos) * 100.0 / measN : na
            table.cell(kc, 0, kRow, nmC, text_color = color.white, text_size = size.small)
            table.cell(kc, 1, kRow, na(wrC) ? "–" : str.tostring(wrC, "#.#") + "%", text_color = color.white, text_size = size.small)
            table.cell(kc, 2, kRow, na(wrC) ? "–" : str.tostring(100 - wrC, "#.#") + "%", text_color = color.white, text_size = size.small)
            table.cell(kc, 3, kRow, kPos == 1 ? "·" : na(ovC) ? "–" : str.tostring(ovC, "#") + "%", text_color = color.white, text_size = size.small)
            table.cell(kc, 4, kRow, cumOk and okC ? str.tostring(100 - cumU, "#.#") + "%" : nC < 10 ? "n<10" : "–",
                 text_color = color.white, text_size = size.small,
                 bgcolor = cumOk and okC ? color.new(color.teal, 80) : na)
            table.cell(kc, 5, kRow, na(measWr) ? "–" : str.tostring(measWr, "#.#") + "% (" + str.tostring(measN) + ")",
                 text_color = color.white, text_size = size.small,
                 bgcolor = not na(measWr) ? color.new(color.olive, 80) : na)
            kRow += 1

// ══════════════════════════ STATUS-TABELLE ══════════════════════════
var table t = table.new(position.bottom_right, 2, 8, border_width = 1)
f_mark(bool ok) => ok ? "✓" : "·"

if barstate.islast and showTable
    table.cell(t, 0, 0, "Confluence", text_color = color.white, bgcolor = color.new(color.black, 20))
    table.cell(t, 1, 0, str.tostring(buyScore) + "▲ / " + str.tostring(sellScore) + "▼ von " + str.tostring(nComp),
         text_color = color.white, bgcolor = color.new(color.black, 20))
    if useTrend
        table.cell(t, 0, 1, autoTrend ? "Trend (Auto)" : "Trend", text_color = color.white,
             tooltip = autoTrend ? "Auto-Modus aktiv — aktuell gewählt: '" + tmName
                  + "' (bester Ø je Trade der bisherigen Historie dieser Aktie, "
                  + "Walk-Forward ohne Blick in die Zukunft)." : "")
        table.cell(t, 1, 1, f_mark(trendBuyOK) + " / " + f_mark(trendSellOK), text_color = color.white)
    if useMACD
        table.cell(t, 0, 2, autoMacd ? "MACD (Auto)" : "MACD Pro", text_color = color.white,
             tooltip = autoMacd ? "Auto-Modus aktiv — aktuell gewählt: '" + mdName
                  + "' (bester Ø je Trade der bisherigen Historie dieser Aktie, "
                  + "Walk-Forward ohne Blick in die Zukunft)." : "")
        table.cell(t, 1, 2, f_mark(macdBuyOK) + " / " + f_mark(macdSellOK), text_color = color.white)
    if useStoch
        table.cell(t, 0, 3, autoStoch ? "Stoch (Auto)" : "Dual Stoch", text_color = color.white,
             tooltip = autoStoch ? "Auto-Modus aktiv — aktuell gewählt: '" + stName
                  + "' (bester Ø je Trade der bisherigen Historie dieser Aktie, "
                  + "Walk-Forward ohne Blick in die Zukunft)." : "")
        table.cell(t, 1, 3, f_mark(stochBuyOK) + " / " + f_mark(stochSellOK), text_color = color.white)
    if useRSI
        table.cell(t, 0, 4, "RSI", text_color = color.white)
        table.cell(t, 1, 4, f_mark(rsiBuyOK) + " / " + f_mark(rsiSellOK), text_color = color.white)
    if useMR
        table.cell(t, 0, 5, "Mean Rev.", text_color = color.white)
        table.cell(t, 1, 5, f_mark(mrBuyOK) + " / " + f_mark(mrSellOK), text_color = color.white)
    if useQS
        table.cell(t, 0, 6, "Support-Qual.", text_color = color.white)
        table.cell(t, 1, 6, f_mark(qsBuyOK) + " / " + f_mark(qsSellOK), text_color = color.white)
    if adxFilter
        table.cell(t, 0, 7, "ADX>20", text_color = color.white)
        table.cell(t, 1, 7, adx > 20 ? "✓" : "·", text_color = color.white)

// ══════════════════════════ ALERTS ══════════════════════════
// FESTE SCHWELLEN-ALERTS, unabhaengig von der Dreieck-Schwelle:
// TradingView friert beim Anlegen eines Alarms die Indikator-
// Einstellungen ein — deshalb gibt es hier je Schwelle eine EIGENE
// Alarm-Bedingung. Beim Anlegen einfach 'min. 2/3/4' bzw. 'ALLE'
// waehlen, ohne vorher die Mindest-Konfluenz umzustellen.
// {{ticker}}/{{close}} im Text: macht Alarme ueber viele Symbole
// (Watchlist) sofort unterscheidbar.
bool alUp2 = buyEvtNow  and adxOK and buyScore  >= 2
bool alUp3 = buyEvtNow  and adxOK and buyScore  >= 3
bool alUp4 = buyEvtNow  and adxOK and buyScore  >= 4
bool alUpA = buyEvtNow  and adxOK and buyScore  >= nComp
bool alDn2 = sellEvtNow and adxOK and sellScore >= 2
bool alDn3 = sellEvtNow and adxOK and sellScore >= 3
bool alDn4 = sellEvtNow and adxOK and sellScore >= 4
bool alDnA = sellEvtNow and adxOK and sellScore >= nComp

alertcondition(alUp2, "UP — min. 2 Komponenten",
     "Stillhalter Confluence {{ticker}}: UP (min. 2 Komponenten) @ {{close}}")
alertcondition(alUp3, "UP — min. 3 Komponenten",
     "Stillhalter Confluence {{ticker}}: UP (min. 3 Komponenten) @ {{close}}")
alertcondition(alUp4, "UP — min. 4 Komponenten",
     "Stillhalter Confluence {{ticker}}: UP (min. 4 Komponenten) @ {{close}}")
alertcondition(alUpA, "UP — ALLE aktiven Komponenten",
     "Stillhalter Confluence {{ticker}}: UP — VOLLE Konfluenz @ {{close}}")
alertcondition(alDn2, "DOWN — min. 2 Komponenten",
     "Stillhalter Confluence {{ticker}}: DOWN (min. 2 Komponenten) @ {{close}}")
alertcondition(alDn3, "DOWN — min. 3 Komponenten",
     "Stillhalter Confluence {{ticker}}: DOWN (min. 3 Komponenten) @ {{close}}")
alertcondition(alDn4, "DOWN — min. 4 Komponenten",
     "Stillhalter Confluence {{ticker}}: DOWN (min. 4 Komponenten) @ {{close}}")
alertcondition(alDnA, "DOWN — ALLE aktiven Komponenten",
     "Stillhalter Confluence {{ticker}}: DOWN — VOLLE Konfluenz @ {{close}}")
// Dreieck-Alerts (folgen der eingestellten Mindest-Konfluenz)
alertcondition(buyTrigger,  "UP — Dreieck (eingestellte Mindest-Konfluenz)",
     "Stillhalter Confluence {{ticker}}: UP-Dreieck @ {{close}}")
alertcondition(sellTrigger, "DOWN — Dreieck (eingestellte Mindest-Konfluenz)",
     "Stillhalter Confluence {{ticker}}: DOWN-Dreieck @ {{close}}")
