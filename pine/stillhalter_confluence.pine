grpB = "Backtest (Staffel: Verlässlichkeit je Konfluenz-Stufe)"
enableBT   = input.bool(true, "Backtest aktivieren (Tabelle oben rechts)", group = grpB,
     tooltip = "Simuliert JE KONFLUENZ-STUFE (Score 1 bis alle aktiven Komponenten) "
          + "unabhängig, wie verlässlich die Kauf-Ereignisse waren — die Tabelle "
          + "zeigt also direkt, wie stark jede zusätzliche Bestätigung die "
          + "Unsicherheit reduziert. Gehandelt wird jedes Kauf-Ereignis mit GENAU "
          + "dieser Stufe, unabhängig von der Dreieck-Schwelle (kein Blick in "
          + "die Zukunft).")
btMode     = input.string("Stillhalter (Short Options)", "🎩 Backtest-Modus",
     options = ["Stillhalter (Short Options)", "Aktie (Long)"], group = grpB,
     tooltip = "Stillhalter = nach jedem Signal der Zeile wird eine Short-Option "
          + "simuliert (Seite unten wählbar): Strike mit Puffer jenseits der "
          + "Referenz, Verfall am ersten Freitag nach der Mindest-Laufzeit. "
          + "Aktie = klassischer Long-Roundtrip je Zeile: Einstieg am Kauf-Signal, "
          + "Ausstieg am Verkaufs-Signal derselben Zeile.")
btSide     = input.string("Short Put", "Options-Seite",
     options = ["Short Put", "Short Call", "Beide (Short Options)"], group = grpB,
     tooltip = "Short Put = Einstieg an den KAUF-Signalen (Strike unter dem Area "
          + "Low). Short Call = Einstieg an den VERKAUFS-Signalen (Strike über "
