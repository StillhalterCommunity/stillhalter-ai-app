grpZ = "🟢🔴 Options-Zonen (Put/Call-Platzierung)"
showZones  = input.bool(true, "Options-Zonen anzeigen", group = grpZ,
     tooltip = "Grüne Boxen unter dem Kurs = Short-Put-Zonen · rote Boxen über dem "
          + "Kurs = Short-Call-Zonen. Regel: Put-Strike UNTER die grüne Box, "
          + "Call-Strike ÜBER die rote Box.")
showYoung  = input.bool(true, "☆ Junge Zonen ergänzen (1× berührt / unbestätigt)", group = grpZ,
     tooltip = "Findet eine Seite weniger STARKE Zonen als erlaubt, werden Levels mit "
          + "nur 1 Berührung und das jüngste (noch unbestätigte) Swing-Tief/-Hoch "
          + "als '☆ jung' ergänzt — so fehlen die naheliegendsten Zonen direkt am "
          + "Kurs nicht mehr. Junge Zonen sind blasser und tragen ☆ statt ★.")
zoneMonths = input.int(36, "Aktualität: letzter Test max. (Monate)", minval = 3, maxval = 48, group = grpZ,
     tooltip = "AKTUALITÄTS-Filter: Eine Zone erscheint nur, wenn ihr LETZTER Test "
          + "höchstens so viele Monate zurückliegt — oder der Kurs sie gerade erneut "
          + "testet. Die STÄRKE (Anzahl Berührungen, Sterne) zählt dagegen über die "
          + "gesamte gespeicherte Historie. Standard 36 — wer nur die frischesten "
          + "Levels will: 12–24.")
zonesPerSide = input.int(3, "Zonen je Seite (max.)", minval = 1, maxval = 6, group = grpZ,
     tooltip = "Höchstens so viele Put-Zonen unter und Call-Zonen über dem Kurs. "
          + "3 = Standard · 2 = aufgeräumter · 4+ für die vollständige Karte.")
zoneDistMult = input.float(0.3, "Mindestabstand vom Kurs (× ATR14)", minval = 0.0,
     maxval = 3.0, step = 0.1, group = grpZ,
     tooltip = "ATR14 = durchschnittliche Schwankung einer Kerze über die letzten 14 "
          + "Kerzen (Average True Range) — das Volatilitätsmaß dieses Indikators. "
          + "0.3 heißt: Eine Zone muss mindestens knapp eine Drittel-Schwankung vom "
          + "Kurs entfernt sein. Je volatiler die Aktie, desto weiter liegen die "
          + "Zonen also automatisch weg. Näher am Kurs = mehr Prämie — die "
          + "nächstgelegene STARKE Zone gewinnt.")
zoneGapMult  = input.float(0.8, "Mindestabstand zwischen Zonen (× ATR14)", minval = 0.3,
     maxval = 5.0, step = 0.1, group = grpZ,
     tooltip = "Verhindert, dass zwei Zonen direkt übereinander kleben: Die nächste "
          + "Zone muss mindestens so viele ATR14 von der vorherigen entfernt sein. "
          + "Kleiner = mehr Zonen dicht am Kurs.")
zoneTolMult  = input.float(0.35, "Cluster-Toleranz (× ATR14)", minval = 0.2, maxval = 1.5,
     step = 0.05, group = grpZ,
     tooltip = "Pivots, die näher als diese Toleranz beieinander liegen, verschmelzen zu "
          + "EINER Zone — so werden Doppel-/Tripel-Tiefs automatisch als starke Zone "
          + "erkannt. 0.35 = Standard (präzise Zonen); größer = breitere Zonen. "
          + "Zusätzlich gilt ein Breiten-Deckel von 0.6 × ATR14 je Zone. (ATR14 = "
          + "durchschnittliche Kerzen-Schwankung der letzten 14 Kerzen.)")

