//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  Stillhalter Community® – RETRACEMENTS v1.2
//  Nachgeführte Retracement-Level vom Allzeittief zum Allzeithoch —
//  die natürliche Landkarte für Einstiegs-Level des Stillhalters.
//
//  NEU in v1.2 — TARNKAPPE (Geheimhaltungs-Regel):
//   • Alle sichtbaren Texte zeigen nur noch neutrale Level-Codes S0–S10
//     (Labels, Tabelle, Stil-Reiter, Einstellungen, Alerts) — keine
//     Ratios mehr, an denen man die Methode ablesen koennte.
//   • Interne Zuordnung (NUR hier im Quellcode): S0=0.000 · S1=0.236 ·
//     S2=0.382 · S3=0.500 · S4=0.618 · S5=0.786 bzw. 0.764 (Variante B)
//     · S6=1.000 (Allzeithoch) · S7=1.618 · S8=2.618 · S9=4.236 ·
//     S10=6.854.
//  v1.1: Umschalter fürs oberste Retracement — 0.786 (klassisch)
//  oder 0.764 (Spiegel-Variante 1−0.236; die NVDA-Statuszeile des
//  IA-Originals zeigt 0.764: 162.09/212.16). Standard: 0.786.
//
//  MECHANIK (dekodiert aus dem IA-ATR-Model — das mit ATR nichts zu tun
//  hat, sondern klassische Fibonacci-Retracements auf Maximal-Historie ist;
//  die blau/orangen Baender des Originals sind ein separates ATR-Trailing-
//  Trendband und werden bei uns vom Stillhalter Trend Model abgedeckt):
//   • Level 6 = 1.000 = nachgeführtes ALLZEITHOCH (steigt mit jedem
//     neuen Hoch mit — dadurch die Treppen-Optik).
//   • Level 0 = 0.000 = Ausgangstief (Allzeittief der verfügbaren
//     Historie; bei alten Aktien praktisch null — daher wirkt es wie
//     'Hoch mal Fibonacci-Faktor'). Wahlweise hart auf 0 setzbar.
//   • Dazwischen die 5 Standard-Ratios: 0.236 · 0.382 · 0.5 · 0.618 ·
//     0.786 (= Level 1–5). Darüber als ZIEL-Level die Erweiterungen
//     der Goldener-Schnitt-Reihe: 1.618 ('Level 7') · 2.618 ('Level 8')
//     · 4.236 ('Level 9') · 6.854 ('Level 10') — bewusst transparenter,
//     die Hauptlevel bleiben 0–6.
//   • Faustformel-Übersetzung der alten %-vom-Hoch-Regel (bei Tief ≈ 0):
//     0.786 ≈ −21% vom Hoch · 0.618 ≈ −38% · 0.5 = −50% · 0.382 ≈ −62%.
//  ANZEIGE: Level-Linien in eigenen Farben, rechts Labels mit Ratio,
//  Preis und Abstand zum aktuellen Kurs in %; Status-Tabelle zeigt die
//  aktuelle Zone und den nächsten Boden darunter. Alerts beim Bruch
//  der wichtigen Level und bei neuem Allzeithoch.
//  HINWEIS: Basis ist die auf TradingView verfügbare Historie des
//  Symbols — auf Tages-/Wochenchart ist das i. d. R. die volle
//  Kurshistorie seit Listing.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Stillhalter Retracements v1.2", shorttitle = "Stillhalter Retracements",
     overlay = true)

// ─── Inputs ──────────────────────────────────────────────────────────────────
grp_lv = "LEVEL"
anchorMode = input.string("Allzeittief (Standard)", "Ausgangspunkt (Level 0)",
     options = ["Allzeittief (Standard)", "Null"], group = grp_lv,
     tooltip = "Wo Level 0 verankert wird: 'Allzeittief' = tiefster Kurs der "
          + "verfügbaren Historie (Original-Verhalten). 'Null' = Level 0 fest "
          + "bei 0 — bei jungen Aktien mit hohem Ausgabekurs testweise "
          + "interessant, sonst Standard lassen.")
fibVariant = input.string("Variante A (Standard)", "S5-Berechnung",
     options = ["Variante A (Standard)", "Variante B (Spiegel)"], group = grp_lv,
     tooltip = "Fuer die Marke S5 existieren zwei gebraeuchliche Varianten. "
          + "Alle anderen Level sind identisch. Zum Abgleich mit einer Vorlage "
          + "einfach den S5-Wert vergleichen und passend umschalten.")
showExt    = input.bool(true, "Ziel-Level über dem Hoch (S7 bis S10)", group = grp_lv,
     tooltip = "Zeigt die Erweiterungs-Level oberhalb des Allzeithochs — dort "
          + "liegen nach einem Ausbruch die nächsten natürlichen Ziele. Bewusst "
          + "transparenter gezeichnet: Die Hauptlevel sind und bleiben 0 bis 6.")
showLabels = input.bool(true, "Level-Beschriftung am rechten Rand", group = grp_lv,
     tooltip = "Level-Code (S0 bis S10), Preis und Abstand zum aktuellen Kurs in % je Level.")
showDist   = input.bool(true, "Abstand zum Kurs in % anzeigen", group = grp_lv,
     tooltip = "Ergänzt jede Beschriftung um den prozentualen Abstand des "
          + "Levels vom aktuellen Kurs — negativ = Level liegt unter dem Kurs "
          + "(möglicher Einstiegs-/Strike-Bereich), positiv = darüber.")
showTable  = input.bool(true, "Status-Tabelle anzeigen", group = grp_lv,
     tooltip = "Zeigt, zwischen welchen Leveln der Kurs gerade notiert und "
          + "wo der nächste Boden darunter liegt (Preis + Abstand).")

grp_st = "FARBEN & OPTIK"
clr100 = input.color(color.white,   "S6 — Allzeithoch", group = grp_st)
clr786 = input.color(#26C6DA,       "S5", group = grp_st)
clr618 = input.color(#00C853,       "S4", group = grp_st)
clr500 = input.color(#FFD600,       "S3", group = grp_st)
clr382 = input.color(#FF9100,       "S2", group = grp_st)
clr236 = input.color(#FF1744,       "S1", group = grp_st)
clr000 = input.color(color.gray,    "S0 — Ausgangstief", group = grp_st)
clrExt = input.color(#AB47BC,       "S7 bis S10 (ueber dem Hoch)", group = grp_st)

// ─── Anker: nachgeführtes Allzeithoch + Ausgangstief ─────────────────────────
var float ath = na
var float atl = na
ath := na(ath) ? high : math.max(ath, high)
atl := na(atl) ? low  : math.min(atl, low)

float base = anchorMode == "Null" ? 0.0 : atl
float rng  = ath - base

f_lv(float r) => base + r * rng

float lv000  = f_lv(0.0)
float lv236  = f_lv(0.236)
float lv382  = f_lv(0.382)
float lv500  = f_lv(0.5)
float lv618  = f_lv(0.618)
float r5     = fibVariant == "Variante B (Spiegel)" ? 0.764 : 0.786
float lv786  = f_lv(r5)
float lv100  = f_lv(1.0)
float lv1618 = showExt ? f_lv(1.618) : na
float lv2618 = showExt ? f_lv(2.618) : na
float lv4236 = showExt ? f_lv(4.236) : na
float lv6854 = showExt ? f_lv(6.854) : na

// ─── Level-Linien (Treppen-Verlauf, da sie nur bei neuem Hoch/Tief springen) ─
plot(lv100,  "S6 (Allzeithoch)",  color = color.new(clr100, 20), linewidth = 2)
plot(lv786,  "S5",                color = color.new(clr786, 20), linewidth = 2)
plot(lv618,  "S4",                color = color.new(clr618, 20), linewidth = 2)
plot(lv500,  "S3",                color = color.new(clr500, 30), linewidth = 1)
plot(lv382,  "S2",                color = color.new(clr382, 30), linewidth = 1)
plot(lv236,  "S1",                color = color.new(clr236, 30), linewidth = 1)
plot(lv000,  "S0 (Ausgangstief)", color = color.new(clr000, 50), linewidth = 1)
plot(lv1618, "S7 (Ziel)",         color = color.new(clrExt, 40), linewidth = 1)
plot(lv2618, "S8 (Ziel)",         color = color.new(clrExt, 50), linewidth = 1)
plot(lv4236, "S9 (Ziel)",         color = color.new(clrExt, 60), linewidth = 1)
plot(lv6854, "S10 (Ziel)",        color = color.new(clrExt, 70), linewidth = 1)

// ─── Beschriftung am rechten Rand ────────────────────────────────────────────
f_pctTxt(float lv) =>
    not showDist or close == 0 ? "" : " · " + (lv >= close ? "+" : "") + str.tostring((lv / close - 1) * 100, "#.#") + "%"

f_lblTxt(string ratio, float lv) =>
    ratio + " — " + str.tostring(lv, format.mintick) + f_pctTxt(lv)

var array<label> lbls = array.new<label>()
if barstate.islast and showLabels
    while array.size(lbls) > 0
        label.delete(array.pop(lbls))
    float[]  lvs  = array.from(lv100, lv786, lv618, lv500, lv382, lv236, lv000)
    string[] nms  = array.from("S6", "S5", "S4", "S3", "S2", "S1", "S0")
    color[]  cls  = array.from(clr100, clr786, clr618, clr500, clr382, clr236, clr000)
    if showExt
        array.unshift(lvs, lv1618), array.unshift(nms, "S7"), array.unshift(cls, clrExt)
        array.unshift(lvs, lv2618), array.unshift(nms, "S8"), array.unshift(cls, clrExt)
        array.unshift(lvs, lv4236), array.unshift(nms, "S9"), array.unshift(cls, clrExt)
        array.unshift(lvs, lv6854), array.unshift(nms, "S10"), array.unshift(cls, clrExt)
    for i = 0 to array.size(lvs) - 1
        float lv = array.get(lvs, i)
        if not na(lv)
            array.push(lbls, label.new(bar_index + 8, lv, f_lblTxt(array.get(nms, i), lv),
                 style = label.style_label_left, color = color.new(color.black, 100),
                 textcolor = array.get(cls, i), size = size.small))

// ─── Status-Tabelle: aktuelle Zone + nächster Boden ──────────────────────────
var table t = table.new(position.bottom_right, 2, 2, border_width = 1)
if barstate.islast and showTable
    float[]  zlvs = array.from(lv000, lv236, lv382, lv500, lv618, lv786, lv100)
    string[] znms = array.from("S0", "S1", "S2", "S3", "S4", "S5", "S6")
    if showExt
        array.push(zlvs, lv1618), array.push(znms, "S7")
        array.push(zlvs, lv2618), array.push(znms, "S8")
        array.push(zlvs, lv4236), array.push(znms, "S9")
        array.push(zlvs, lv6854), array.push(znms, "S10")
    string zoneTxt  = "unter S0"
    string floorTxt = "–"
    for i = 0 to array.size(zlvs) - 1
        if close >= array.get(zlvs, i)
            zoneTxt := i == array.size(zlvs) - 1 ? "ueber " + array.get(znms, i) :
                 "zwischen " + array.get(znms, i) + " und " + array.get(znms, i + 1)
            floorTxt := array.get(znms, i) + " · " + str.tostring(array.get(zlvs, i), format.mintick)
                 + " · " + str.tostring((array.get(zlvs, i) / close - 1) * 100, "#.#") + "%"
    table.cell(t, 0, 0, "Zone", text_color = color.white, bgcolor = color.new(color.black, 20))
    table.cell(t, 1, 0, zoneTxt, text_color = color.white, bgcolor = color.new(color.black, 20))
    table.cell(t, 0, 1, "Naechster Boden", text_color = color.white)
    table.cell(t, 1, 1, floorTxt, text_color = color.white)

// ─── Alerts ──────────────────────────────────────────────────────────────────
alertcondition(ta.crossunder(close, lv786), "Kurs faellt unter S5", "Stillhalter Retracements: Kurs unter S5 gefallen")
alertcondition(ta.crossunder(close, lv618), "Kurs faellt unter S4", "Stillhalter Retracements: Kurs unter S4 gefallen")
alertcondition(ta.crossunder(close, lv500), "Kurs faellt unter S3", "Stillhalter Retracements: Kurs unter S3 gefallen")
alertcondition(ta.crossunder(close, lv382), "Kurs faellt unter S2", "Stillhalter Retracements: Kurs unter S2 gefallen")
alertcondition(ta.crossover(close, lv786),  "Kurs erobert S5 zurueck", "Stillhalter Retracements: Kurs zurueck ueber S5")
alertcondition(ta.crossover(close, lv618),  "Kurs erobert S4 zurueck", "Stillhalter Retracements: Kurs zurueck ueber S4")
alertcondition(high >= ath and high > ath[1], "Neues Allzeithoch", "Stillhalter Retracements: neues Allzeithoch — alle Level werden nachgezogen")
