//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  Stillhalter Community® – RETRACEMENTS v2.0
//  Nachgeführte Retracement-Level + Trailing-Band mit Buy/Sell-Signalen —
//  die natürliche Landkarte für Einstiegs-Level des Stillhalters.
//
//  NEU in v2.0 — TRAILING-BAND + NULL-ANKER (Feedback):
//   • TRAILING-BAND (das blau/orange Band des IA-Originals, hier als
//     eigenstaendiger Baustein): nachlaufender Stopp im Abstand der
//     aktuellen Schwankungsbreite (SuperTrend-Mechanik, ATR-basiert).
//     Kurs darueber = Band laeuft als Unterstuetzung mit (petrol),
//     Bruch nach unten = Band klappt auf die Oberseite (magenta) —
//     bewusst ANDERE Farben als das Original.
//     Die Umklapp-Momente sind die Signale: kleines gruenes Dreieck
//     (Buy) unter der Kerze · kleines rotes Dreieck (Sell) darueber —
//     bewusst anders als die Confluence-Optik. Band + Signale einzeln
//     abschaltbar; der Stillhalter Trend bleibt separat und unberuehrt.
//   • Alle Level-Linien standardmaessig in duennster Linienstaerke.
//   • LEVEL-0-ANKER: Standard jetzt NULL (Level = Ratio x Allzeithoch,
//     ueberall exakt reproduzierbar). Waehlbar: Allzeittief · Jahres- ·
//     2-Jahres- · 5-Jahres- · 10-Jahres-Tief (rollierend aus der
//     Monats-Historie, auch auf Intraday-Charts).
//  v1.3 — ANKER-FIX: Allzeithoch/-tief aus der MONATS-Historie
//   (reicht auch auf 4h-Charts bis zum Listing zurueck; nur bestaetigte
//   Monate, kein Repaint) kombiniert mit dem lokalen Chart-Fenster —
//   Level identisch auf allen Zeiteinheiten, Treppen nur nach oben.
//  v1.2 — TARNKAPPE: sichtbare Texte zeigen nur Level-Codes S0–S10.
//   Interne Zuordnung (NUR hier im Quellcode): S0=0.000 · S1=0.236 ·
//   S2=0.382 · S3=0.500 · S4=0.618 · S5=0.786 bzw. 0.764 (Variante B) ·
//   S6=1.000 (Allzeithoch) · S7=1.618 · S8=2.618 · S9=4.236 · S10=6.854.
//   Trailing-Band intern: SuperTrend ATR-Laenge 10, Faktor 3,
//   Bandkante EMA(hl2, 8).
//  v1.1 — Umschalter oberstes Retracement: 0.786 (klassisch) oder
//   0.764 (Spiegel-Variante; das IA-Original nutzt 0.764).
//
//  MECHANIK (dekodiert aus dem IA-ATR-Model): Level 6 = nachgefuehrtes
//  ALLZEITHOCH inkl. Docht; darunter die Standard-Ratios (s. o.);
//  darueber die Ziel-Level der Goldener-Schnitt-Reihe. Faustformel bei
//  Anker 0: S5 ≈ −21% vom Hoch · S4 ≈ −38% · S3 = −50% · S2 ≈ −62%.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Stillhalter Retracements v2.0", shorttitle = "Stillhalter Retracements",
     overlay = true)

// ─── Inputs: Level ───────────────────────────────────────────────────────────
grp_lv = "LEVEL"
anchorMode = input.string("Null (Standard)", "Ausgangspunkt (Level 0 / S0)",
     options = ["Null (Standard)", "Allzeittief", "Jahrestief", "2-Jahres-Tief", "5-Jahres-Tief", "10-Jahres-Tief"], group = grp_lv,
     tooltip = "Wo S0 verankert wird. 'Null' = Standard: Die Level haengen nur "
          + "am Allzeithoch und sind ueberall exakt reproduzierbar. Alternativ "
          + "ein Tief als Anker: Allzeittief oder das rollierende Tief der "
          + "letzten 1/2/5/10 Jahre — dann spannen sich die Level zwischen "
          + "diesem Tief und dem Allzeithoch auf.")
fibVariant = input.string("Variante A (Standard)", "S5-Berechnung",
     options = ["Variante A (Standard)", "Variante B (Spiegel)"], group = grp_lv,
     tooltip = "Fuer die Marke S5 existieren zwei gebraeuchliche Varianten. "
          + "Alle anderen Level sind identisch. Zum Abgleich mit einer Vorlage "
          + "einfach den S5-Wert vergleichen und passend umschalten.")
showExt    = input.bool(true, "Ziel-Level über dem Hoch (S7 bis S10)", group = grp_lv,
     tooltip = "Zeigt die Erweiterungs-Level oberhalb des Allzeithochs — dort "
          + "liegen nach einem Ausbruch die nächsten natürlichen Ziele. Bewusst "
          + "transparenter gezeichnet: Die Hauptlevel sind und bleiben 0 bis 6.")
showLabels = input.bool(true, "Level-Beschriftung am rechten Rand", group = grp_lv,
     tooltip = "Level-Code (S0 bis S10), Preis und Abstand zum aktuellen Kurs in % je Level.")
showDist   = input.bool(true, "Abstand zum Kurs in % anzeigen", group = grp_lv,
     tooltip = "Ergänzt jede Beschriftung um den prozentualen Abstand des "
          + "Levels vom aktuellen Kurs — negativ = Level liegt unter dem Kurs "
          + "(möglicher Einstiegs-/Strike-Bereich), positiv = darüber.")
showTable  = input.bool(true, "Status-Tabelle anzeigen", group = grp_lv,
     tooltip = "Zeigt, zwischen welchen Leveln der Kurs gerade notiert und "
          + "wo der nächste Boden darunter liegt (Preis + Abstand).")

// ─── Inputs: Trailing-Band ───────────────────────────────────────────────────
grp_tb = "TRAILING-BAND"
showBand = input.bool(true, "Trailing-Band anzeigen", group = grp_tb,
     tooltip = "Nachlaufender Stopp im Abstand der aktuellen Schwankungsbreite: "
          + "Kurs darueber = Band laeuft als Unterstuetzung mit (Aufwaertsmodus), "
          + "Bruch nach unten = Band klappt auf die Oberseite (Abwaertsmodus).")
showSigs = input.bool(true, "Buy/Sell-Signale am Band-Wechsel", group = grp_tb,
     tooltip = "Kleines gruenes Dreieck (Buy) unter der Kerze, wenn das Band in "
          + "den Aufwaertsmodus klappt · kleines rotes Dreieck (Sell) ueber der "
          + "Kerze beim Wechsel in den Abwaertsmodus.")
bandTransp = input.int(80, "Band-Transparenz", minval = 0, maxval = 100, group = grp_tb,
     tooltip = "0 = kraeftig gefuellt · 100 = Fuellung unsichtbar (Linien und "
          + "Signale bleiben).")
clrUp = input.color(#00897B, "Band aufwaerts", group = grp_tb)
clrDn = input.color(#D81B60, "Band abwaerts",  group = grp_tb)

// ─── Inputs: Farben Level ────────────────────────────────────────────────────
grp_st = "FARBEN LEVEL"
clr100 = input.color(color.white,   "S6 — Allzeithoch", group = grp_st)
clr786 = input.color(#26C6DA,       "S5", group = grp_st)
clr618 = input.color(#00C853,       "S4", group = grp_st)
clr500 = input.color(#FFD600,       "S3", group = grp_st)
clr382 = input.color(#FF9100,       "S2", group = grp_st)
clr236 = input.color(#FF1744,       "S1", group = grp_st)
clr000 = input.color(color.gray,    "S0 — Ausgangspunkt", group = grp_st)
clrExt = input.color(#AB47BC,       "S7 bis S10 (ueber dem Hoch)", group = grp_st)

// ─── Anker: Allzeithoch + Tiefs aus der Monats-Historie ─────────────────────
// Tiefe Historie ueber Monatsdaten (reicht auch auf Intraday-Charts bis zum
// Listing zurueck); nur BESTAETIGTE Monate ([1] + lookahead) → kein Repaint.
// Das lokale Chart-Fenster bzw. der laufende Monat decken die Luecke ab.
f_anchors() =>
    var float hh = na
    var float ll = na
    hh := na(hh) ? high : math.max(hh, high)
    ll := na(ll) ? low  : math.min(ll, low)
    [hh[1], ll[1], ta.lowest(low, 12)[1], ta.lowest(low, 24)[1], ta.lowest(low, 60)[1], ta.lowest(low, 120)[1]]

[athHist, atlHist, lo1y, lo2y, lo5y, lo10y] = request.security(syminfo.tickerid, "M", f_anchors(),
     lookahead = barmerge.lookahead_on)

var float athLoc = na
var float atlLoc = na
athLoc := na(athLoc) ? high : math.max(athLoc, high)
atlLoc := na(atlLoc) ? low  : math.min(atlLoc, low)

// Tief des laufenden Monats (schliesst die Luecke der bestaetigten Monate)
var float curMoLow = na
bool newMonth = ta.change(time("M")) != 0
curMoLow := newMonth or na(curMoLow) ? low : math.min(curMoLow, low)

float ath = math.max(nz(athHist, athLoc), athLoc)
float atl = math.min(nz(atlHist, atlLoc), atlLoc)

f_rollLow(float loN) => math.min(nz(loN, atl), curMoLow)

float base = switch anchorMode
    "Allzeittief"    => atl
    "Jahrestief"     => f_rollLow(lo1y)
    "2-Jahres-Tief"  => f_rollLow(lo2y)
    "5-Jahres-Tief"  => f_rollLow(lo5y)
    "10-Jahres-Tief" => f_rollLow(lo10y)
    =>                  0.0
float rng = ath - base

f_lv(float r) => base + r * rng

float lv000  = f_lv(0.0)
float lv236  = f_lv(0.236)
float lv382  = f_lv(0.382)
float lv500  = f_lv(0.5)
float lv618  = f_lv(0.618)
float r5     = fibVariant == "Variante B (Spiegel)" ? 0.764 : 0.786
float lv786  = f_lv(r5)
float lv100  = f_lv(1.0)
float lv1618 = showExt ? f_lv(1.618) : na
float lv2618 = showExt ? f_lv(2.618) : na
float lv4236 = showExt ? f_lv(4.236) : na
float lv6854 = showExt ? f_lv(6.854) : na

// ─── Level-Linien (Treppen-Verlauf, da sie nur bei neuem Hoch springen) ──────
plot(lv100,  "S6 (Allzeithoch)",  color = color.new(clr100, 20), linewidth = 1)
plot(lv786,  "S5",                color = color.new(clr786, 20), linewidth = 1)
plot(lv618,  "S4",                color = color.new(clr618, 20), linewidth = 1)
plot(lv500,  "S3",                color = color.new(clr500, 30), linewidth = 1)
plot(lv382,  "S2",                color = color.new(clr382, 30), linewidth = 1)
plot(lv236,  "S1",                color = color.new(clr236, 30), linewidth = 1)
plot(lv000,  "S0 (Ausgangspunkt)",color = color.new(clr000, 50), linewidth = 1)
plot(lv1618, "S7 (Ziel)",         color = color.new(clrExt, 40), linewidth = 1)
plot(lv2618, "S8 (Ziel)",         color = color.new(clrExt, 50), linewidth = 1)
plot(lv4236, "S9 (Ziel)",         color = color.new(clrExt, 60), linewidth = 1)
plot(lv6854, "S10 (Ziel)",        color = color.new(clrExt, 70), linewidth = 1)

// ─── Trailing-Band (eigenstaendig — der Stillhalter Trend bleibt separat) ────
[stLine, stDir] = ta.supertrend(3.0, 10)
float bandEdge = ta.ema(hl2, 8)
bool upMode  = stDir < 0
bool flipUp  = ta.change(stDir) < 0
bool flipDn  = ta.change(stDir) > 0

color bandClr = upMode ? clrUp : clrDn
p_st   = plot(showBand ? stLine   : na, "Trailing-Stopp", color = color.new(bandClr, 35), linewidth = 1, style = plot.style_linebr)
p_edge = plot(showBand ? bandEdge : na, "Band-Kante",     color = color.new(bandClr, 75), linewidth = 1)
fill(p_st, p_edge, color = showBand ? color.new(bandClr, bandTransp) : na, title = "Band-Fuellung")

plotshape(showSigs and flipUp, "Buy (Band klappt aufwaerts)", shape.triangleup, location.belowbar,
     color.new(color.green, 0), size = size.tiny)
plotshape(showSigs and flipDn, "Sell (Band klappt abwaerts)", shape.triangledown, location.abovebar,
     color.new(color.red, 0), size = size.tiny)

// ─── Beschriftung am rechten Rand ────────────────────────────────────────────
f_pctTxt(float lv) =>
    not showDist or close == 0 ? "" : " · " + (lv >= close ? "+" : "") + str.tostring((lv / close - 1) * 100, "#.#") + "%"

f_lblTxt(string nm, float lv) =>
    nm + " — " + str.tostring(lv, format.mintick) + f_pctTxt(lv)

var array<label> lbls = array.new<label>()
if barstate.islast and showLabels
    while array.size(lbls) > 0
        label.delete(array.pop(lbls))
    float[]  lvs  = array.from(lv100, lv786, lv618, lv500, lv382, lv236, lv000)
    string[] nms  = array.from("S6", "S5", "S4", "S3", "S2", "S1", "S0")
    color[]  cls  = array.from(clr100, clr786, clr618, clr500, clr382, clr236, clr000)
    if showExt
        array.unshift(lvs, lv1618), array.unshift(nms, "S7"), array.unshift(cls, clrExt)
        array.unshift(lvs, lv2618), array.unshift(nms, "S8"), array.unshift(cls, clrExt)
        array.unshift(lvs, lv4236), array.unshift(nms, "S9"), array.unshift(cls, clrExt)
        array.unshift(lvs, lv6854), array.unshift(nms, "S10"), array.unshift(cls, clrExt)
    for i = 0 to array.size(lvs) - 1
        float lv = array.get(lvs, i)
        if not na(lv)
            array.push(lbls, label.new(bar_index + 8, lv, f_lblTxt(array.get(nms, i), lv),
                 style = label.style_label_left, color = color.new(color.black, 100),
                 textcolor = array.get(cls, i), size = size.small))

// ─── Status-Tabelle: aktuelle Zone + nächster Boden ──────────────────────────
var table t = table.new(position.bottom_right, 2, 2, border_width = 1)
if barstate.islast and showTable
    float[]  zlvs = array.from(lv000, lv236, lv382, lv500, lv618, lv786, lv100)
    string[] znms = array.from("S0", "S1", "S2", "S3", "S4", "S5", "S6")
    if showExt
        array.push(zlvs, lv1618), array.push(znms, "S7")
        array.push(zlvs, lv2618), array.push(znms, "S8")
        array.push(zlvs, lv4236), array.push(znms, "S9")
        array.push(zlvs, lv6854), array.push(znms, "S10")
    string zoneTxt  = "unter S0"
    string floorTxt = "–"
    for i = 0 to array.size(zlvs) - 1
        if close >= array.get(zlvs, i)
            zoneTxt := i == array.size(zlvs) - 1 ? "ueber " + array.get(znms, i) :
                 "zwischen " + array.get(znms, i) + " und " + array.get(znms, i + 1)
            floorTxt := array.get(znms, i) + " · " + str.tostring(array.get(zlvs, i), format.mintick)
                 + " · " + str.tostring((array.get(zlvs, i) / close - 1) * 100, "#.#") + "%"
    table.cell(t, 0, 0, "Zone", text_color = color.white, bgcolor = color.new(color.black, 20))
    table.cell(t, 1, 0, zoneTxt, text_color = color.white, bgcolor = color.new(color.black, 20))
    table.cell(t, 0, 1, "Naechster Boden", text_color = color.white)
    table.cell(t, 1, 1, floorTxt, text_color = color.white)

// ─── Alerts ──────────────────────────────────────────────────────────────────
alertcondition(flipUp, "Band-Buy",  "Stillhalter Retracements: Trailing-Band klappt aufwaerts (Buy)")
alertcondition(flipDn, "Band-Sell", "Stillhalter Retracements: Trailing-Band klappt abwaerts (Sell)")
alertcondition(ta.crossunder(close, lv786), "Kurs faellt unter S5", "Stillhalter Retracements: Kurs unter S5 gefallen")
alertcondition(ta.crossunder(close, lv618), "Kurs faellt unter S4", "Stillhalter Retracements: Kurs unter S4 gefallen")
alertcondition(ta.crossunder(close, lv500), "Kurs faellt unter S3", "Stillhalter Retracements: Kurs unter S3 gefallen")
alertcondition(ta.crossunder(close, lv382), "Kurs faellt unter S2", "Stillhalter Retracements: Kurs unter S2 gefallen")
alertcondition(ta.crossover(close, lv786),  "Kurs erobert S5 zurueck", "Stillhalter Retracements: Kurs zurueck ueber S5")
alertcondition(ta.crossover(close, lv618),  "Kurs erobert S4 zurueck", "Stillhalter Retracements: Kurs zurueck ueber S4")
alertcondition(ath > ath[1], "Neues Allzeithoch", "Stillhalter Retracements: neues Allzeithoch — alle Level werden nachgezogen")
